{% extends 'layout.twig' %}
{% import 'common/macros.twig' as ui %}

{% block title %}{{ 'Tickets'|t }} — {{ app_name }}{% endblock %}
{% block heading %}{{ 'Tickets'|t }}{% endblock %}

{% block actions %}
    <a class="button button--primary" href="{{ url('/tickets/create') }}">{{ 'New ticket'|t }}</a>
{% endblock %}

{% block content %}
    {#
        The filters are a GET form, so a filtered list is a URL: it can be
        bookmarked, sent to somebody and reloaded without a warning about
        resubmitting anything.
    #}
    <form class="filters card" method="get" action="{{ url('/tickets') }}">
        <input class="field field--inline filters__search" type="search" name="q"
               value="{{ filters.q }}" placeholder="{{ 'Search title, text or CT-14'|t }}" aria-label="{{ 'Search tickets'|t }}">

        <select class="field field--inline" name="project" aria-label="{{ 'Project'|t }}">
            <option value="">{{ 'Every project'|t }}</option>
            {% for project in projects %}
                <option value="{{ project.id }}"{{ filters.project_id == project.id ? ' selected' : '' }}>
                    {{ project.code }} — {{ project.name }}
                </option>
            {% endfor %}
        </select>

        {# Every project has its own columns, so across projects the choice is
           the kind of column; once one project is picked, its columns too. #}
        <select class="field field--inline" name="status" aria-label="{{ 'Status'|t }}">
            <option value="">{{ 'Any status'|t }}</option>
            {% for category in ['todo', 'in_progress', 'done'] %}
                <option value="{{ category }}"{{ filters.status == category ? ' selected' : '' }}>{{ ui.category_label(category) }}</option>
            {% endfor %}
            {% if statuses is not empty %}
                <optgroup label="{{ 'Columns'|t }}">
                    {% for status in statuses %}
                        <option value="{{ status.id }}"{{ filters.status == status.id ~ '' ? ' selected' : '' }}>{{ status.name|t }}</option>
                    {% endfor %}
                </optgroup>
            {% endif %}
        </select>

        <select class="field field--inline" name="assignee" aria-label="{{ 'Assignee'|t }}">
            <option value="">{{ 'Anyone'|t }}</option>
            {% for person in people %}
                <option value="{{ person.id }}"{{ filters.assignee_id == person.id ? ' selected' : '' }}>{{ person.name }}</option>
            {% endfor %}
        </select>

        <label class="check check--inline">
            <input type="checkbox" name="open" value="1"{{ filters.open_only ? ' checked' : '' }}>
            {{ 'Open only'|t }}
        </label>

        <button class="button" type="submit">{{ 'Filter'|t }}</button>
        <a class="button" href="{{ url('/tickets') }}">{{ 'Clear'|t }}</a>
    </form>

    <section class="card card--flush">
        {% if tickets is empty %}
            <p class="card__empty">{{ 'Nothing matches that.'|t }}</p>
        {% else %}
            <header class="card__head">
                {# The count is said out loud: a list that stops at a page size
                   without saying so is a list that hides work. #}
                <span class="muted">
                    {{ 'Showing {from}–{to} of {total}'|t({
                        from: (page - 1) * per_page + 1,
                        to: min(page * per_page, total),
                        total: total
                    }) }}
                </span>
            </header>
            <table class="table">
                <thead>
                <tr>
                    <th class="table__key">{{ 'Ticket'|t }}</th>
                    <th>{{ 'Title'|t }}</th>
                    <th>{{ 'Status'|t }}</th>
                    <th>{{ 'Assignee'|t }}</th>
                    <th class="table__number">{{ 'Est.'|t }}</th>
                    <th class="table__number">{{ 'Logged'|t }}</th>
                </tr>
                </thead>
                <tbody>
                {% for ticket in tickets %}
                    <tr>
                        <td>{{ ui.ticket_key(ticket) }}</td>
                        <td>
                            <a href="{{ url('/tickets/' ~ ticket.id) }}">{{ ticket.title }}</a>
                            {{ ui.priority(ticket.priority) }}
                            {% if ticket.epic_title %}<span class="tag">{{ ticket.epic_title }}</span>{% endif %}
                        </td>
                        <td>{{ ui.status(ticket.status_name, ticket.status_colour) }}</td>
                        <td>{{ ui.person(ticket.assignee_name) }}</td>
                        <td class="table__number">{{ ticket.estimate_minutes ? ticket.estimate_minutes|duration : '—' }}</td>
                        <td class="table__number">{{ ticket.logged_minutes > 0 ? ticket.logged_minutes|duration : '—' }}</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        {% endif %}
    </section>

    {{ ui.pages('/tickets', query, page, pages) }}
{% endblock %}
