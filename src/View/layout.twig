{#
    The frame every signed-in page sits in: the sidebar, the top bar and the
    content column.

    The sidebar is a list of links rather than a component with state, because
    which one is current can be worked out from the path — one place, and no
    controller has to remember to say so.
#}
<!DOCTYPE html>
{# The attribute written out, and only its value printed: printed whole, the
   quotes around the value were escaped with it, the browser read the theme as
   '"light"', and a light choice showed dark on a dark system. #}
<html lang="{{ locale }}"{% if theme in ['light', 'dark'] %} data-theme="{{ theme }}"{% endif %}>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    {# For the few requests the page's own script sends; forms carry theirs. #}
    <meta name="csrf-token" content="{{ csrf_token }}">
    {% if current_user %}<meta name="suggest-url" content="{{ url('/suggest') }}">{% endif %}
    <meta name="base-url" content="{{ base_url }}">
    <title>{% block title %}{{ app_name }}{% endblock %}</title>
    <link rel="icon" href="{{ asset('favicon.svg') }}" type="image/svg+xml">
    <link rel="stylesheet" href="{{ asset('css/app.css') }}">
    <script src="{{ asset('js/app.js') }}" defer></script>
</head>
<body class="app"{% if search_project is defined %} data-project-id="{{ search_project.id }}"{% endif %}>
<a class="skip-link" href="#main">{{ 'Skip to the content'|t }}</a>

<aside class="sidebar">
    <div class="sidebar__top">
        <a class="sidebar__brand" href="{{ url('/') }}">
            <span class="sidebar__mark">{% include 'common/logo.twig' with {size: 22} %}</span>
            <span class="sidebar__name">{{ app_name }}</span>
        </a>
        {# On a phone the menu folds away behind this; without a script it
           stays open, as it always was. #}
        <button class="sidebar__toggle" type="button" data-menu-toggle aria-expanded="false" aria-controls="sidebar-menu">
            <span aria-hidden="true">☰</span> {{ 'Menu'|t }}
        </button>
    </div>
    <div class="sidebar__menu" id="sidebar-menu">

    {# Type a ticket's name and be on it; anything else searches the list.
       "/" puts the cursor here from anywhere. #}
    <form class="sidebar__search" method="get" action="{{ url('/search') }}" role="search">
        <input class="field" type="search" name="q" placeholder="{{ 'Search or jump to CT-14'|t }}"
               aria-label="{{ 'Search'|t }}" data-shortcut-search>
        {% if search_project is defined %}<input type="hidden" name="project" value="{{ search_project.code }}">{% endif %}
    </form>

    <nav class="sidebar__nav" aria-label="{{ 'Main'|t }}">
        {% set items = [
            { path: '/', label: 'Dashboard', icon: 'speedometer2' },
            { path: '/projects', label: 'Projects', icon: 'kanban' },
            { path: '/roadmap', label: 'Roadmap', icon: 'signpost-split' },
            { path: '/tickets', label: 'Tickets', icon: 'card-checklist' },
            { path: '/timesheet', label: 'Timesheet', icon: 'calendar-week' },
            { path: '/planning', label: 'Planning', icon: 'calendar2-range' },
            { path: '/reports', label: 'Reports', icon: 'bar-chart-line' }
        ] %}
        {# A guest has no hours and no reports to look at. #}
        {% if not can_work %}
            {% set items = items|filter(item => item.path not in ['/timesheet', '/planning', '/reports']) %}
        {% endif %}

        {% for item in items %}
            {# The dashboard is the only path that has to match exactly: every
               other path starts with a slash and a word, so "starts with" would
               make "/" current on every page. #}
            {% set active = item.path == '/' ? current_path == '/' : (current_path starts with item.path and not (current_path starts with '/timesheet/approvals')) %}
            <a class="sidebar__link{{ active ? ' is-active' : '' }}" href="{{ url(item.path) }}"
               {{ active ? 'aria-current="page"' : '' }}><i class="bi bi-{{ item.icon }}" aria-hidden="true"></i><span>{{ item.label|t }}</span></a>
        {% endfor %}


        {# Named apart from `filters`, which the list pages use for their own:
           a template and its layout share one set of variables. #}
        {% set sidebar_filters = saved_filters() %}
        {% if sidebar_filters is not empty %}
            <span class="sidebar__section">{{ 'Filters'|t }}</span>
            {% for filter in sidebar_filters %}
                <a class="sidebar__link sidebar__link--filter" href="{{ url('/tickets?' ~ filter.query ~ (filter.query ? '&' : '') ~ 'filter=' ~ filter.id) }}"
                   title="{{ filter.mine ? '' : 'Shared by {name}'|t({name: filter.user_name}) }}">
                    <i class="bi bi-funnel" aria-hidden="true"></i><span>{{ filter.name }}</span>{% if not filter.mine %} <span class="sidebar__shared">↗</span>{% endif %}
                </a>
            {% endfor %}
        {% endif %}

        {% if is_admin %}
            <span class="sidebar__section">{{ 'Administration'|t }}</span>
            <a class="sidebar__link{{ current_path starts with '/people' ? ' is-active' : '' }}"
               href="{{ url('/people') }}"><i class="bi bi-people" aria-hidden="true"></i><span>{{ 'People'|t }}</span></a>
            <a class="sidebar__link{{ current_path starts with '/timesheet/approvals' ? ' is-active' : '' }}"
               href="{{ url('/timesheet/approvals') }}"><i class="bi bi-clipboard-check" aria-hidden="true"></i><span>{{ 'Approvals'|t }}</span>{% set waiting = pending_weeks() %}{% if waiting > 0 %} <span class="sidebar__count">{{ waiting }}</span>{% endif %}</a>
            <a class="sidebar__link{{ current_path starts with '/settings/work-types' ? ' is-active' : '' }}"
               href="{{ url('/settings/work-types') }}"><i class="bi bi-tags" aria-hidden="true"></i><span>{{ 'Work types'|t }}</span></a>
            <a class="sidebar__link{{ current_path starts with '/settings' and not (current_path starts with '/settings/webhooks') and not (current_path starts with '/settings/work-types') and not (current_path starts with '/settings/automation') ? ' is-active' : '' }}"
               href="{{ url('/settings') }}"><i class="bi bi-calendar3" aria-hidden="true"></i><span>{{ 'Calendar'|t }}</span></a>
            <a class="sidebar__link{{ current_path starts with '/settings/automation' ? ' is-active' : '' }}"
               href="{{ url('/settings/automation') }}"><i class="bi bi-lightning-charge" aria-hidden="true"></i><span>{{ 'Automation'|t }}</span></a>
            <a class="sidebar__link{{ current_path starts with '/settings/webhooks' ? ' is-active' : '' }}"
               href="{{ url('/settings/webhooks') }}"><i class="bi bi-broadcast" aria-hidden="true"></i><span>{{ 'Webhooks'|t }}</span></a>
        {% endif %}
    </nav>
    </div>

    {# The running clock, wherever one is: what it runs on, for how long, and
       the button that turns it into hours. #}
    {% set timer = running_timer() %}
    {% if timer %}
        <div class="timer" data-timer-started="{{ timer.started_at|date('U') }}">
            <a class="timer__what" href="{{ url('/tickets/' ~ timer.ticket_id) }}" title="{{ timer.ticket_title }}">
                <span class="timer__dot" aria-hidden="true"></span>
                {{ timer.project_code }}-{{ timer.ticket_number }}
                <span class="timer__clock" data-timer-clock>{{ ((('now'|date('U')) - timer.started_at|date('U')) / 60)|round(0, 'floor') }}m</span>
            </a>
            <form method="post" action="{{ url('/timer/stop') }}">
                <input type="hidden" name="_token" value="{{ csrf_token }}">
                <input type="hidden" name="back" value="{{ current_path }}">
                <button class="button button--small" type="submit">{{ 'Stop and log'|t }}</button>
            </form>
        </div>
    {% endif %}

</aside>

<div class="main">
    <header class="topbar">
        {% if can_work %}
            {# The one thing somebody does here most often, from any page.
               Without the script it is a link to the week's grid. #}
            <a class="topbar__log button button--primary button--small" href="{{ url('/timesheet?view=grid') }}" data-quick-log-open
               title="{{ 'Log time'|t }} (l)">
                <i class="bi bi-stopwatch" aria-hidden="true"></i>{{ 'Log time'|t }}
            </a>
            <span class="topbar__spacer"></span>
        {% endif %}

        {# What happened to the tickets somebody follows: a bell, with the
           number not yet read on it. #}
        {% set unread = unread_notifications() %}
        <a class="topbar__icon topbar__bell{{ current_path starts with '/notifications' ? ' is-active' : '' }}" href="{{ url('/notifications') }}"
           title="{{ 'Notifications'|t }}"
           aria-label="{{ unread > 0 ? 'Notifications'|t ~ ' — ' ~ plural('{count} not read', '{count} not read', unread) : 'Notifications'|t }}">
            <i class="bi bi-bell" aria-hidden="true"></i>
            {% if unread > 0 %}<span class="topbar__badge" aria-hidden="true">{{ unread > 99 ? '99+' : unread }}</span>{% endif %}
        </a>

        {# Light or dark in one click. Which one the page is in right now is
           filled in by the script, since with "the system's" chosen only the
           browser knows. #}
        {% set dark_now = theme == 'dark' %}
        <form class="theme-switch" method="post" action="{{ url('/profile/theme') }}" data-theme-switch
              data-to-dark="{{ 'Switch to the dark theme'|t }}" data-to-light="{{ 'Switch to the light theme'|t }}">
            <input type="hidden" name="_token" value="{{ csrf_token }}">
            <input type="hidden" name="back" value="{{ current_path }}{{ current_query ? '?' ~ current_query : '' }}">
            <input type="hidden" name="shown" value="{{ dark_now ? 'dark' : 'light' }}">
            <button class="topbar__icon" type="submit"
                    title="{{ dark_now ? 'Switch to the light theme'|t : 'Switch to the dark theme'|t }}"
                    aria-label="{{ dark_now ? 'Switch to the light theme'|t : 'Switch to the dark theme'|t }}">
                <i class="bi bi-moon-stars theme-switch__moon" aria-hidden="true"></i>
                <i class="bi bi-sun theme-switch__sun" aria-hidden="true"></i>
            </button>
        </form>

        {# The language, as in the rest of the family: the two letters, and a
           short menu of the languages by their own names. #}
        <details class="lang-menu" data-menu>
            <summary class="lang-pill" title="{{ 'Language'|t }}" aria-label="{{ 'Language'|t }}">
                <i class="bi bi-translate" aria-hidden="true"></i><span>{{ locale|upper }}</span>
            </summary>
            <div class="menu menu--narrow">
                {% for code, name in locales %}
                    <form method="post" action="{{ url('/locale') }}">
                        <input type="hidden" name="_token" value="{{ csrf_token }}">
                        <input type="hidden" name="back" value="{{ current_path }}{{ current_query ? '?' ~ current_query : '' }}">
                        <button class="menu__item{{ code == locale ? ' is-current' : '' }}" type="submit" name="locale" value="{{ code }}" lang="{{ code }}"
                                {{ code == locale ? 'aria-current="true"' : '' }}>
                            <i class="bi {{ code == locale ? 'bi-check2' : '' }}" aria-hidden="true"></i>{{ name }}
                        </button>
                    </form>
                {% endfor %}
            </div>
        </details>

        <button class="topbar__icon" type="button" data-shortcut-help
                title="{{ 'Keyboard shortcuts'|t }}" aria-label="{{ 'Keyboard shortcuts'|t }}">
            <i class="bi bi-question-circle" aria-hidden="true"></i>
        </button>

        {% import 'common/macros.twig' as faces %}
        <details class="user-menu" data-menu>
            <summary class="user-pill" aria-label="{{ 'Your account: {name}'|t({name: current_user.name}) }}">
                {{ faces.face(current_user.name, current_user.id, 'avatar') }}
                <span class="user-pill__name">{{ current_user.name }}</span>
                <i class="bi bi-chevron-down" aria-hidden="true"></i>
            </summary>
            <div class="menu">
                <div class="menu__head">
                    <strong>{{ current_user.name }}</strong>
                    <small>{{ current_user.email }} · {{ {admin: 'Administrator', guest: 'Guest'}[current_user.role]|default('Member')|t }}</small>
                </div>
                <a class="menu__item" href="{{ url('/profile') }}"><i class="bi bi-person" aria-hidden="true"></i>{{ 'Edit your profile'|t }}</a>
                <a class="menu__item" href="{{ url('/profile/two-factor') }}"><i class="bi bi-shield-lock" aria-hidden="true"></i>{{ 'Two-step sign-in'|t }}</a>
                <a class="menu__item" href="{{ url('/profile/tokens') }}"><i class="bi bi-key" aria-hidden="true"></i>{{ 'Access tokens'|t }}</a>
                <hr class="menu__rule">
                {# A form, because signing out changes something: a link would
                   let any page on the internet sign somebody out with an image. #}
                <form method="post" action="{{ url('/logout') }}">
                    <input type="hidden" name="_token" value="{{ csrf_token }}">
                    <button class="menu__item" type="submit"><i class="bi bi-box-arrow-right" aria-hidden="true"></i>{{ 'Sign out'|t }}</button>
                </form>
            </div>
        </details>
    </header>

<main class="content" id="main">
    <header class="content__head" data-refresh="head">
        <div>
            <h1>{% block heading %}{% endblock %}</h1>
            {% block subheading %}{% endblock %}
        </div>
        <div class="content__actions">{% block actions %}{% endblock %}</div>
    </header>

    {% for message in flash %}
        <p class="flash flash--{{ message.kind }}" role="{{ message.kind == 'danger' ? 'alert' : 'status' }}">{{ message.message }}</p>
    {% endfor %}

    {% block content %}{% endblock %}
</main>
</div>

{# The keyboard shortcuts, opened with "?". A dialog element, so the browser
   handles focus and Escape. #}
<dialog class="shortcuts" id="shortcuts" aria-labelledby="shortcuts-title">
    <h2 id="shortcuts-title">{{ 'Keyboard shortcuts'|t }}</h2>
    <dl class="shortcuts__list">
        <dt><kbd>/</kbd></dt><dd>{{ 'Search, or jump to a ticket by its name'|t }}</dd>
        <dt><kbd>c</kbd></dt><dd>{{ 'Create a ticket'|t }}</dd>
        <dt><kbd>g</kbd> <kbd>d</kbd></dt><dd>{{ 'Go to the dashboard'|t }}</dd>
        <dt><kbd>g</kbd> <kbd>p</kbd></dt><dd>{{ 'Go to the projects'|t }}</dd>
        <dt><kbd>g</kbd> <kbd>t</kbd></dt><dd>{{ 'Go to the tickets'|t }}</dd>
        <dt><kbd>g</kbd> <kbd>s</kbd></dt><dd>{{ 'Go to your timesheet'|t }}</dd>
        <dt><kbd>g</kbd> <kbd>b</kbd></dt><dd>{{ 'Go to this project’s board'|t }}</dd>
        <dt><kbd>g</kbd> <kbd>k</kbd></dt><dd>{{ 'Go to this project’s backlog'|t }}</dd>
        <dt><kbd>g</kbd> <kbd>v</kbd></dt><dd>{{ 'Go to this project’s releases'|t }}</dd>
        <dt><kbd>g</kbd> <kbd>w</kbd></dt><dd>{{ 'Go to this project’s pages'|t }}</dd>
        <dt><kbd>g</kbd> <kbd>r</kbd></dt><dd>{{ 'Go to the roadmap — this project’s, in a project'|t }}</dd>
        <dt><kbd>g</kbd> <kbd>q</kbd></dt><dd>{{ 'Write a query on the ticket list'|t }}</dd>
        <dt><kbd>l</kbd></dt><dd>{{ 'Log time on any ticket'|t }}</dd>
        <dt><kbd>?</kbd></dt><dd>{{ 'Show this list'|t }}</dd>
    </dl>
    <form method="dialog"><button class="button">{{ 'Close'|t }}</button></form>
</dialog>

{% if can_work %}{% include 'common/quick_log.twig' %}{% endif %}
{% if current_user %}
    {# A ticket beside the page, opened from a card or a row — see inline.js. #}
    <aside class="panel" data-panel-root hidden aria-label="{{ 'Ticket'|t }}"
           data-panel-url="{{ url('/tickets/{id}/panel') }}" data-ticket-url="{{ url('/tickets/{id}') }}">
        <button class="panel__close" type="button" data-panel-close aria-label="{{ 'Close'|t }}" title="{{ 'Close'|t }} (Esc)">
            <i class="bi bi-x-lg" aria-hidden="true"></i>
        </button>
        <div class="panel__body" data-panel-body></div>
    </aside>
{% endif %}
</body>
</html>
