{% extends 'auth/frame.twig' %}

{% block title %}{{ 'Sign in'|t }}{% endblock %}

{% block card %}
    <h1>{{ app_name }}</h1>
    <p class="auth__lead">{{ 'Issue tracking, and the hours that went into it.'|t }}</p>

    {% if error %}
        <p class="flash flash--danger" role="alert">{{ error }}</p>
    {% endif %}

    <form method="post" action="{{ url('/login') }}" novalidate>
        <input type="hidden" name="_token" value="{{ csrf_token }}">

        <label for="email">{{ 'Email address'|t }}</label>
        <input id="email" class="field" type="email" name="email" value="{{ email }}"
               autocomplete="username" autofocus required>

        <label for="password">{{ 'Password'|t }}</label>
        <input id="password" class="field" type="password" name="password"
               autocomplete="current-password" required>

        <button class="button button--primary button--block" type="submit">{{ 'Sign in'|t }}</button>
    </form>

    <p class="auth__back"><a href="{{ url('/password/forgot') }}">{{ 'Forgot your password?'|t }}</a></p>
{% endblock %}
