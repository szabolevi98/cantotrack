{% extends 'layout.twig' %}

{% set editing = epic is not null and epic.id is defined %}

{% block title %}{{ editing ? 'Edit epic'|t : 'New epic'|t }} — {{ app_name }}{% endblock %}
{% block heading %}{{ editing ? 'Edit epic'|t : 'New epic'|t }}{% endblock %}
{% block subheading %}<p class="content__sub">{{ 'In {project}'|t({project: project.name ~ ' (' ~ project.code ~ ')'}) }}</p>{% endblock %}

{% block content %}
    {% if error %}<p class="flash flash--danger">{{ error }}</p>{% endif %}

    <section class="card card--narrow">
        <form method="post"
              action="{{ editing ? url('/epics/' ~ epic.id) : url('/projects/' ~ project.id ~ '/epics/create') }}">
            <input type="hidden" name="_token" value="{{ csrf_token }}">

            <label for="title">{{ 'Title'|t }}</label>
            <input id="title" class="field" type="text" name="title" value="{{ epic.title|default('') }}"
                   maxlength="200" required autofocus>

            <label for="description">{{ 'Description'|t }}</label>
            <textarea id="description" class="field" name="description" rows="5" data-suggest>{{ epic.description|default('') }}</textarea>

            <div class="form__row">
                <div>
                    <label for="starts_on">{{ 'Starts'|t }}</label>
                    <input id="starts_on" class="field" type="date" name="starts_on" value="{{ epic.starts_on|default('') }}">
                </div>
                <div>
                    <label for="ends_on">{{ 'Ends'|t }}</label>
                    <input id="ends_on" class="field" type="date" name="ends_on" value="{{ epic.ends_on|default('') }}">
                </div>
            </div>
            <p class="hint">{{ 'Where it sits on the roadmap. Left empty, the roadmap draws it from its tickets.'|t }}</p>

            {% if editing %}
                <label class="check">
                    <input type="checkbox" name="is_done" value="1"{{ epic.is_done ? ' checked' : '' }}>
                    {{ 'Done — kept for its history, and no longer offered on ticket forms'|t }}
                </label>
            {% endif %}

            <div class="form__actions">
                <button class="button button--primary" type="submit">{{ editing ? 'Save'|t : 'Create epic'|t }}</button>
                <a class="button" href="{{ editing ? url('/epics/' ~ epic.id) : url('/projects/' ~ project.id) }}">{{ 'Cancel'|t }}</a>
            </div>
        </form>
    </section>

    {% if editing %}
        <section class="card card--narrow">
            <h2 class="card__title">{{ 'Delete this epic'|t }}</h2>
            <p class="card__body">
                {{ 'The tickets stay in the project and lose their epic — nothing that was worked on is deleted.'|t }}
            </p>
            <form method="post" action="{{ url('/epics/' ~ epic.id ~ '/delete') }}"
                  data-confirm="{{ 'Delete this epic? Its tickets stay in the project.'|t }}">
                <input type="hidden" name="_token" value="{{ csrf_token }}">
                <button class="button button--danger" type="submit">{{ 'Delete epic'|t }}</button>
            </form>
        </section>
    {% endif %}
{% endblock %}
