{% extends 'layout.twig' %}

{% block title %}{{ 'Your profile'|t }} — {{ app_name }}{% endblock %}
{% block heading %}{{ 'Your profile'|t }}{% endblock %}
{% block subheading %}<p class="content__sub">{{ me.email }}</p>{% endblock %}

{% block content %}
    {% import 'common/macros.twig' as ui %}
    <section class="card card--narrow profile-picture">
        <h2 class="card__title">{{ 'Your picture'|t }}</h2>
        <div class="profile-picture__row">
            {{ ui.face(me.name, me.id, 'avatar avatar--large') }}
            <form method="post" action="{{ url('/profile/avatar') }}" enctype="multipart/form-data">
                <input type="hidden" name="_token" value="{{ csrf_token }}">
                <input class="field" type="file" name="avatar" accept="image/png,image/jpeg,image/webp,image/gif" required aria-label="{{ 'Picture'|t }}">
                <p class="hint">{{ 'PNG, JPEG, WebP or GIF, up to 5 MB. The middle square of it is used.'|t }}</p>
                <button class="button button--small" type="submit">{{ 'Upload'|t }}</button>
            </form>
            {% if me.avatar %}
                <form method="post" action="{{ url('/profile/avatar/delete') }}">
                    <input type="hidden" name="_token" value="{{ csrf_token }}">
                    <button class="link-button link-button--text" type="submit">{{ 'Remove the picture'|t }}</button>
                </form>
            {% endif %}
        </div>
    </section>

    <section class="card card--narrow">
        <h2 class="card__title">{{ 'About you'|t }}</h2>
        {% if error %}<p class="flash flash--danger">{{ error }}</p>{% endif %}

        <form method="post" action="{{ url('/profile') }}">
            <input type="hidden" name="_token" value="{{ csrf_token }}">

            <label for="name">{{ 'Name'|t }}</label>
            <input id="name" class="field" type="text" name="name" value="{{ me.name }}" maxlength="120" required>

            <label for="short_name">{{ 'What should we call you?'|t }}</label>
            <input id="short_name" class="field" type="text" name="short_name" value="{{ me.short_name }}"
                   maxlength="60">
            <p class="hint">{{ 'Used where the application talks to you, like the greeting on the dashboard. Left empty, it uses your whole name.'|t }}</p>

            <div class="form__row">
                <div>
                    <label for="locale">{{ 'Language'|t }}</label>
                    <select id="locale" class="field" name="locale">
                        {% for code, label in locales %}
                            <option value="{{ code }}"{{ (me.locale ?: locale) == code ? ' selected' : '' }}>{{ label }}</option>
                        {% endfor %}
                    </select>
                </div>

                <div>
                    <label for="theme">{{ 'Appearance'|t }}</label>
                    <select id="theme" class="field" name="theme">
                        {% for value, label in {system: 'Same as the system', light: 'Light', dark: 'Dark'} %}
                            <option value="{{ value }}"{{ me.theme == value ? ' selected' : '' }}>{{ label|t }}</option>
                        {% endfor %}
                    </select>
                </div>
            </div>

            <label class="check">
                <input type="checkbox" name="notify_email" value="1"{{ me.notify_email ? ' checked' : '' }}>
                {{ 'Email me what I am notified about — tickets given to me, mentions, and changes to what I follow'|t }}
            </label>

            <div class="form__actions">
                <button class="button button--primary" type="submit">{{ 'Save'|t }}</button>
            </div>
        </form>
    </section>

    <section class="card card--narrow">
        <h2 class="card__title">{{ 'Password'|t }}</h2>
        {% if password_error %}<p class="flash flash--danger">{{ password_error }}</p>{% endif %}
        <p class="card__body">
            {% if me.password_changed_at %}
                {{ 'Last changed on {day}.'|t({day: me.password_changed_at|day}) }}
            {% else %}
                {{ 'You are still using the password you were given. Choose one of your own — the person who made the account has seen that one.'|t }}
            {% endif %}
        </p>

        <form method="post" action="{{ url('/profile/password') }}">
            <input type="hidden" name="_token" value="{{ csrf_token }}">
            {# The address, so a password manager files the new password under
               the right account. #}
            <input type="email" name="username" value="{{ me.email }}" autocomplete="username" hidden>

            <label for="current_password">{{ 'Current password'|t }}</label>
            <input id="current_password" class="field" type="password" name="current_password"
                   autocomplete="current-password" required>

            <div class="form__row">
                <div>
                    <label for="new_password">{{ 'New password'|t }}</label>
                    <input id="new_password" class="field" type="password" name="new_password"
                           autocomplete="new-password" minlength="10" required>
                </div>
                <div>
                    <label for="new_password_again">{{ 'The new one again'|t }}</label>
                    <input id="new_password_again" class="field" type="password" name="new_password_again"
                           autocomplete="new-password" minlength="10" required>
                </div>
            </div>
            <p class="hint">{{ 'At least 10 characters. A few ordinary words strung together is stronger than a short jumble, and easier to type.'|t }}</p>

            <div class="form__actions">
                <button class="button button--primary" type="submit">{{ 'Change password'|t }}</button>
            </div>
        </form>
    </section>

    <section class="card card--narrow">
        <h2 class="card__title">{{ 'Two-step sign-in'|t }}</h2>
        <p class="card__body">
            {{ me.totp_enabled_at ? 'On: signing in also takes a code from your phone.'|t : 'Off: the password alone signs you in.'|t }}
        </p>
        <a class="button" href="{{ url('/profile/two-factor') }}">{{ me.totp_enabled_at ? 'Manage'|t : 'Set it up'|t }}</a>
    </section>

    <section class="card card--narrow">
        <h2 class="card__title">{{ 'Access tokens'|t }}</h2>
        <p class="card__body">{{ 'For scripts and other programs that use the API on your behalf.'|t }}</p>
        <a class="button" href="{{ url('/profile/tokens') }}">{{ 'Manage tokens'|t }}</a>
    </section>
{% endblock %}
