{% extends 'layout.twig' %}
{% import 'common/macros.twig' as ui %}

{% block title %}{{ 'Tickets'|t }} — {{ app_name }}{% endblock %}
{% block heading %}{{ 'Tickets'|t }}{% endblock %}

{% block actions %}
    {% if can_work %}<a class="button button--primary" href="{{ url('/tickets/create') }}">{{ 'New ticket'|t }}</a>{% endif %}
{% endblock %}

{% block content %}
    {# Two ways to say which tickets: the filters, or a query written out. #}
    <nav class="segmented tickets__mode" aria-label="{{ 'How to find tickets'|t }}">
        <a class="segmented__item{{ not query_mode ? ' is-active' : '' }}" href="{{ url('/tickets') }}">{{ 'Filters'|t }}</a>
        <a class="segmented__item{{ query_mode ? ' is-active' : '' }}"
           href="{{ url('/tickets?' ~ (as_query ? 'query=' ~ as_query|url_encode : 'mode=query')) }}"
           title="{{ 'The filters chosen now, written out as a query'|t }}">{{ 'Query'|t }}</a>
    </nav>

    {% if query_mode %}
        {#
            The query: one line of the query language, sent as a GET form like
            the filters, so a query is a URL too — and a saved filter.
        #}
        <form class="card query-form" method="get" action="{{ url('/tickets') }}" data-query-form
              data-values-url="{{ url('/tickets/query/values') }}"
              data-fields="{{ vocabulary.fields|merge(custom_names|map(n => n matches '/^[\\w]+$/' ? n : '"' ~ n ~ '"'))|json_encode }}">
            {{ sort_inputs() }}
            <label class="visually-hidden" for="query">{{ 'Query'|t }}</label>
            <div class="query-form__row">
                <div class="query-form__box">
                    <input id="query" class="field field--code query-form__input{{ query_error ? ' field--error' : '' }}" type="text" name="query"
                           value="{{ query_text }}" autocomplete="off" spellcheck="false"{{ query_text ? '' : ' autofocus' }}
                           placeholder="project = BIKE AND assignee = me AND category != done ORDER BY priority DESC"
                           role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="query-suggestions"
                           {{ query_error ? 'aria-invalid="true" aria-describedby="query-error"' : '' }}>
                    <ul class="query-form__suggestions" id="query-suggestions" role="listbox" hidden></ul>
                </div>
                <button class="button button--primary" type="submit">{{ 'Search'|t }}</button>
            </div>
            {% if query_error %}<p class="query-form__error" id="query-error" role="alert">{{ query_error }}</p>{% endif %}

            <details class="query-form__help">
                <summary class="link-button link-button--text">{{ 'How to write a query'|t }}</summary>
                <div class="query-form__guide">
                    <div>
                        <h3>{{ 'Fields'|t }}</h3>
                        <p><code>{{ vocabulary.fields|join('</code> <code>')|raw }}</code></p>
                        {% if custom_names is not empty %}
                            <p>{{ 'And the projects’ own:'|t }} {% for name in custom_names %}<code>{{ name matches '/^[\\w]+$/' ? name : '"' ~ name ~ '"' }}</code> {% endfor %}</p>
                        {% endif %}
                        <h3>{{ 'Operators'|t }}</h3>
                        <p><code>=</code> <code>!=</code> <code>&lt;</code> <code>&lt;=</code> <code>&gt;</code> <code>&gt;=</code> {{ 'for numbers, days and priorities;'|t }} <code>~</code> <code>!~</code> {{ 'for words in the text;'|t }} <code>IN (…)</code> <code>NOT IN (…)</code> <code>IS EMPTY</code> <code>IS NOT EMPTY</code></p>
                        <h3>{{ 'Days'|t }}</h3>
                        <p>{{ 'A date, a distance from today, or a function:'|t }} <code>2026-10-01</code> <code>-7d</code> <code>2w</code> <code>-1m</code> <code>startOfWeek()</code> <code>endOfMonth()</code></p>
                    </div>
                    <div>
                        <h3>{{ 'Examples'|t }}</h3>
                        <ul class="query-form__examples">
                            {% for example in [
                                'assignee = me AND category != done ORDER BY priority DESC',
                                'type = bug AND priority >= high AND created >= -14d',
                                'sprint IN openSprints() AND assignee IS EMPTY',
                                'release IN unreleased() AND category = done',
                                'due < startOfDay() AND category != done ORDER BY due',
                                'text ~ "checkout" OR labels IN (payments, shop)',
                                'project = BIKE AND logged > 2d ORDER BY logged DESC',
                            ] %}
                                <li><a href="{{ url('/tickets?query=' ~ example|url_encode) }}"><code>{{ example }}</code></a></li>
                            {% endfor %}
                        </ul>
                    </div>
                </div>
            </details>
        </form>
    {% else %}
    {#
        The filters are a GET form, so a filtered list is a URL: it can be
        bookmarked, sent to somebody and reloaded without a warning about
        resubmitting anything.
    #}
    <form class="filters card" method="get" action="{{ url('/tickets') }}">
        {{ sort_inputs() }}
        <input class="field field--inline filters__search" type="search" name="q"
               value="{{ filters.q }}" placeholder="{{ 'Search title, text or CT-14'|t }}" aria-label="{{ 'Search tickets'|t }}">

        <select class="field field--inline" name="project" aria-label="{{ 'Project'|t }}">
            <option value="">{{ 'Every project'|t }}</option>
            {% for project in projects %}
                <option value="{{ project.id }}"{{ filters.project_id == project.id ? ' selected' : '' }}>
                    {{ project.code }} — {{ project.name }}
                </option>
            {% endfor %}
        </select>

        {# Every project has its own columns, so across projects the choice is
           the kind of column; once one project is picked, its columns too. #}
        <select class="field field--inline" name="status" aria-label="{{ 'Status'|t }}">
            <option value="">{{ 'Any status'|t }}</option>
            {% for category in ['todo', 'in_progress', 'done'] %}
                <option value="{{ category }}"{{ filters.status == category ? ' selected' : '' }}>{{ ui.category_label(category) }}</option>
            {% endfor %}
            {% if statuses is not empty %}
                <optgroup label="{{ 'Columns'|t }}">
                    {% for status in statuses %}
                        <option value="{{ status.id }}"{{ filters.status == status.id ~ '' ? ' selected' : '' }}>{{ status.name|t }}</option>
                    {% endfor %}
                </optgroup>
            {% endif %}
        </select>

        <select class="field field--inline" name="assignee" aria-label="{{ 'Assignee'|t }}">
            <option value="">{{ 'Anyone'|t }}</option>
            {% for person in people %}
                <option value="{{ person.id }}"{{ filters.assignee_id == person.id ? ' selected' : '' }}>{{ person.name }}</option>
            {% endfor %}
        </select>

        <select class="field field--inline" name="type" aria-label="{{ 'Type'|t }}">
            <option value="">{{ 'Any type'|t }}</option>
            {% for value in types %}
                <option value="{{ value }}"{{ filters.type == value ? ' selected' : '' }}>{{ ui.type_label(value) }}</option>
            {% endfor %}
        </select>

        {% if labels is not empty %}
            <select class="field field--inline" name="label" aria-label="{{ 'Label'|t }}">
                <option value="">{{ 'Any label'|t }}</option>
                {% for label in labels %}
                    <option value="{{ label.name }}"{{ filters.label == label.name ? ' selected' : '' }}>{{ label.name }}</option>
                {% endfor %}
            </select>
        {% endif %}

        {% if releases is not empty %}
            <select class="field field--inline" name="release" aria-label="{{ 'Release'|t }}">
                <option value="">{{ 'Any release'|t }}</option>
                {% for release in releases %}
                    <option value="{{ release.id }}"{{ filters.release_id == release.id ? ' selected' : '' }}>{{ release.name }}{{ release.released_at ? ' ✓' : '' }}</option>
                {% endfor %}
            </select>
        {% endif %}

        <select class="field field--inline" name="due" aria-label="{{ 'Due'|t }}">
            <option value="">{{ 'Any due date'|t }}</option>
            <option value="overdue"{{ filters.due == 'overdue' ? ' selected' : '' }}>{{ 'Overdue'|t }}</option>
            <option value="week"{{ filters.due == 'week' ? ' selected' : '' }}>{{ 'Due this week'|t }}</option>
        </select>

        <label class="check check--inline">
            <input type="checkbox" name="open" value="1"{{ filters.open_only ? ' checked' : '' }}>
            {{ 'Open only'|t }}
        </label>

        <button class="button" type="submit">{{ 'Filter'|t }}</button>
        <a class="button" href="{{ url('/tickets') }}">{{ 'Clear'|t }}</a>
    </form>
    {% endif %}

    {# Keeping this list: a name, and whether the rest of the team sees it too. #}
    <details class="save-filter"{{ saved ? '' : '' }}>
        <summary class="link-button link-button--text">
            {{ saved ? 'Saved filter: {name}'|t({name: saved.name}) : 'Save this filter'|t }}
        </summary>
        {% if saved %}
            {% if saved.user_id == current_user.id or is_admin %}
                <form method="post" action="{{ url('/filters/' ~ saved.id ~ '/delete') }}"
                      data-confirm="{{ 'Delete the filter “{name}”?'|t({name: saved.name}) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token }}">
                    <button class="button button--small button--danger" type="submit">{{ 'Delete this filter'|t }}</button>
                </form>
            {% endif %}
        {% else %}
            <form class="save-filter__form" method="post" action="{{ url('/filters') }}">
                <input type="hidden" name="_token" value="{{ csrf_token }}">
                <input type="hidden" name="query" value="{{ query }}">
                <input class="field field--inline" type="text" name="name" maxlength="80" required
                       placeholder="{{ 'My open bugs'|t }}" aria-label="{{ 'Name'|t }}">
                <label class="check check--inline"><input type="checkbox" name="is_shared" value="1"> {{ 'Share with everybody'|t }}</label>
                <button class="button button--small" type="submit">{{ 'Save'|t }}</button>
            </form>
        {% endif %}
    </details>

    {#
        The list is a form of its own: ticking rows and choosing a change in
        the bar under it changes them all, each through its own rules.
    #}
    <form method="post" action="{{ url('/tickets/bulk') }}" class="bulk" data-bulk>
    <input type="hidden" name="_token" value="{{ csrf_token }}">
    <input type="hidden" name="back" value="/tickets{{ query ? '?' ~ query : '' }}">
    <section class="card card--flush">
        {% if tickets is empty %}
            <p class="card__empty">{{ 'Nothing matches that.'|t }}</p>
        {% else %}
            <header class="card__head">
                {# The count is said out loud: a list that stops at a page size
                   without saying so is a list that hides work. #}
                <a class="tickets__export" href="{{ url('/tickets/export' ~ (query ? '?' ~ query : '')) }}">{{ 'As a spreadsheet'|t }}</a>
                <span class="muted">
                    {{ 'Showing {from}–{to} of {total}'|t({
                        from: (page - 1) * per_page + 1,
                        to: min(page * per_page, total),
                        total: total
                    }) }}
                </span>
            </header>
            <table class="table">
                <thead>
                <tr>
                    <th class="table__check">
                        <input type="checkbox" data-bulk-all aria-label="{{ 'Tick every ticket on this page'|t }}">
                    </th>
                    <th class="table__key" {{ sort_aria('key') }}>{{ sort_link('key', 'Ticket'|t) }}</th>
                    <th {{ sort_aria('title') }}>{{ sort_link('title', 'Title'|t) }}</th>
                    <th {{ sort_aria('status') }}>{{ sort_link('status', 'Status'|t) }}</th>
                    <th {{ sort_aria('assignee') }}>{{ sort_link('assignee', 'Assignee'|t) }}</th>
                    <th {{ sort_aria('due') }}>{{ sort_link('due', 'Due'|t) }}</th>
                    <th class="table__number" {{ sort_aria('estimate') }}>{{ sort_link('estimate', 'Est.'|t) }}</th>
                    <th class="table__number" {{ sort_aria('logged') }}>{{ sort_link('logged', 'Logged'|t) }}</th>
                </tr>
                </thead>
                <tbody>
                {% for ticket in tickets %}
                    <tr>
                        <td class="table__check">
                            <input type="checkbox" name="ids[]" value="{{ ticket.id }}"
                                   aria-label="{{ 'Tick {key}'|t({key: ticket.project_code ~ '-' ~ ticket.number}) }}">
                        </td>
                        <td class="table__key">{{ ui.type_icon(ticket.type) }} {{ ui.ticket_key(ticket) }}</td>
                        <td>
                            <a href="{{ url('/tickets/' ~ ticket.id) }}" data-panel>{{ ticket.title }}</a>{{ ui.family(ticket) }}
                            {{ ui.priority(ticket.priority) }}
                            {% if ticket.epic_title %}<span class="tag">{{ ticket.epic_title }}</span>{% endif %}
                            {{ ui.labels(ticket.label_names|lines, false) }}
                        </td>
                        <td>{{ ui.status(ticket.status_name, ticket.status_colour) }} {{ ui.resolution(ticket) }}</td>
                        <td>{{ ui.person(ticket.assignee_name, ticket.assignee_id) }}</td>
                        <td>{{ ui.due(ticket.due_on, ticket.status_category == 'done') }}</td>
                        <td class="table__number">{{ ticket.estimate_minutes ? ticket.estimate_minutes|duration : '—' }}</td>
                        <td class="table__number">{{ ticket.logged_minutes > 0 ? ticket.logged_minutes|duration : '—' }}</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        {% endif %}
    </section>

    {% if tickets is not empty and can_work %}
        {# The change for the ticked rows. Only what is chosen changes; the
           rest of each ticket stays as it is. #}
        <div class="bulk__bar card" data-bulk-bar>
            <strong class="bulk__count" data-bulk-count>{{ 'Change the ticked tickets'|t }}</strong>

            <select class="field field--inline" name="set_status" aria-label="{{ 'Status'|t }}">
                <option value="">{{ 'Status…'|t }}</option>
                {% for category in ['todo', 'in_progress', 'done'] %}
                    <option value="{{ category }}">{{ ui.category_label(category) }}</option>
                {% endfor %}
                {% if statuses is not empty %}
                    <optgroup label="{{ 'Columns'|t }}">
                        {% for status in statuses %}<option value="{{ status.id }}">{{ status.name|t }}</option>{% endfor %}
                    </optgroup>
                {% endif %}
            </select>

            <select class="field field--inline" name="set_assignee" aria-label="{{ 'Assignee'|t }}">
                <option value="">{{ 'Assignee…'|t }}</option>
                <option value="none">{{ 'Unassigned'|t }}</option>
                {% for person in people %}<option value="{{ person.id }}">{{ person.name }}</option>{% endfor %}
            </select>

            <select class="field field--inline" name="set_priority" aria-label="{{ 'Priority'|t }}">
                <option value="">{{ 'Priority…'|t }}</option>
                {% for value in ['low', 'normal', 'high', 'urgent'] %}<option value="{{ value }}">{{ ui.priority_label(value) }}</option>{% endfor %}
            </select>

            <select class="field field--inline" name="set_type" aria-label="{{ 'Type'|t }}">
                <option value="">{{ 'Type…'|t }}</option>
                {% for value in types %}<option value="{{ value }}">{{ ui.type_label(value) }}</option>{% endfor %}
            </select>

            {% if sprints is not empty %}
                <select class="field field--inline" name="set_sprint" aria-label="{{ 'Sprint'|t }}">
                    <option value="">{{ 'Sprint…'|t }}</option>
                    <option value="backlog">{{ 'Backlog'|t }}</option>
                    {% for sprint in sprints %}<option value="{{ sprint.id }}">{{ sprint.name }}{% if sprint.board_project_id is null %} · {{ sprint.board_name }}{% endif %}</option>{% endfor %}
                </select>
            {% endif %}

            {% set coming = releases|filter(r => r.released_at is null) %}
            {% if coming is not empty %}
                <select class="field field--inline" name="set_release" aria-label="{{ 'Release'|t }}">
                    <option value="">{{ 'Release…'|t }}</option>
                    <option value="none">{{ 'No release'|t }}</option>
                    {% for release in coming %}<option value="{{ release.id }}">{{ release.name }}</option>{% endfor %}
                </select>
            {% endif %}

            <input class="field field--inline bulk__label" type="text" name="add_label" list="bulk-labels"
                   placeholder="{{ '+ label'|t }}" aria-label="{{ 'Add a label'|t }}">
            <input class="field field--inline bulk__label" type="text" name="remove_label" list="bulk-labels"
                   placeholder="{{ '− label'|t }}" aria-label="{{ 'Remove a label'|t }}">
            <datalist id="bulk-labels">{% for label in labels %}<option value="{{ label.name }}">{% endfor %}</datalist>

            <button class="button button--primary" type="submit">{{ 'Apply'|t }}</button>
        </div>
    {% endif %}
    </form>

    {{ ui.pages('/tickets', query, page, pages) }}
{% endblock %}
