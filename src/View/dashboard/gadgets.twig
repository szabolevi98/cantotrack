{#
    The pieces a person added to their own dashboard, each drawn from a
    query (see Gadgets), and the form that adds another.
#}
{% import 'common/macros.twig' as ui %}
<div id="gadgets">
    {% if gadgets is not empty %}
        <div class="gadgets">
            {% for gadget in gadgets %}
                <section class="card gadget gadget--{{ gadget.kind }}">
                    <header class="gadget__head">
                        <h2 class="card__title"><a href="{{ url(gadget.link) }}">{{ gadget.title }}</a></h2>
                        <div class="gadget__tools">
                            <form method="post" action="{{ url('/dashboard/gadgets/' ~ gadget.id ~ '/move') }}">
                                <input type="hidden" name="_token" value="{{ csrf_token }}">
                                <button class="link-button" type="submit" name="direction" value="up" {{ loop.first ? 'disabled' : '' }}
                                        aria-label="{{ 'Move {name} up'|t({name: gadget.title}) }}" title="{{ 'Move up'|t }}">↑</button>
                                <button class="link-button" type="submit" name="direction" value="down" {{ loop.last ? 'disabled' : '' }}
                                        aria-label="{{ 'Move {name} down'|t({name: gadget.title}) }}" title="{{ 'Move down'|t }}">↓</button>
                            </form>
                            <form method="post" action="{{ url('/dashboard/gadgets/' ~ gadget.id ~ '/delete') }}"
                                  data-confirm="{{ 'Take {name} off your dashboard?'|t({name: gadget.title}) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token }}">
                                <button class="link-button" type="submit" aria-label="{{ 'Take {name} off your dashboard'|t({name: gadget.title}) }}" title="{{ 'Remove'|t }}">×</button>
                            </form>
                        </div>
                    </header>

                    {% if gadget.error %}
                        <p class="flash flash--danger">{{ gadget.error }}</p>
                    {% elseif gadget.kind == 'count' %}
                        <a class="gadget__count" href="{{ url(gadget.link) }}">{{ gadget.count }}</a>
                        <p class="muted gadget__query"><code>{{ gadget.query ?: '—' }}</code></p>
                    {% elseif gadget.kind == 'list' %}
                        {% if gadget.tickets is empty %}
                            <p class="card__body muted">{{ 'Nothing matches it.'|t }}</p>
                        {% else %}
                            <ul class="gadget__list">
                                {% for ticket in gadget.tickets %}
                                    <li>
                                        <span class="gadget__key">{{ ui.type_icon(ticket.type) }} {{ ui.ticket_key(ticket) }}</span>
                                        <a href="{{ url('/tickets/' ~ ticket.id) }}" data-panel>{{ ticket.title }}</a>
                                        {{ ui.status(ticket.status_name, ticket.status_colour) }}
                                    </li>
                                {% endfor %}
                            </ul>
                            {% if gadget.count > gadget.tickets|length %}
                                <p class="gadget__more"><a href="{{ url(gadget.link) }}">{{ 'All {count}'|t({count: gadget.count}) }}</a></p>
                            {% endif %}
                        {% endif %}
                    {% else %}
                        {% set most = max(gadget.groups|column('count')|merge([1])) %}
                        {% if gadget.groups is empty %}
                            <p class="card__body muted">{{ 'Nothing matches it.'|t }}</p>
                        {% else %}
                            <ul class="gadget__bars">
                                {% for group in gadget.groups %}
                                    <li>
                                        <a href="{{ url(group.link) }}">
                                            <span class="gadget__label">{{ not group.label ? (gadget.group_by == 'assignee' ? 'Nobody'|t : 'None'|t) : (gadget.group_by in ['priority', 'type'] ? group.label|capitalize|t : (gadget.group_by == 'status' ? group.label|t : group.label)) }}</span>
                                            <span class="gadget__bar"><span style="width: {{ (group.count / most * 100)|round }}%"></span></span>
                                            <span class="gadget__number">{{ group.count }}</span>
                                        </a>
                                    </li>
                                {% endfor %}
                            </ul>
                        {% endif %}
                    {% endif %}
                </section>
            {% endfor %}
        </div>
    {% endif %}

    <details class="card gadget-add"{{ gadgets is empty ? ' open' : '' }}>
        <summary class="card__title">{{ 'Add to your dashboard'|t }}</summary>
        <p class="card__body muted">{{ 'Anything a query finds: the tickets as a list, how many there are, or how they split by a field.'|t }}</p>
        <form class="gadget-add__form" method="post" action="{{ url('/dashboard/gadgets') }}">
            <input type="hidden" name="_token" value="{{ csrf_token }}">
            <label for="gadget-title">{{ 'Title'|t }}</label>
            <input id="gadget-title" class="field" type="text" name="title" maxlength="120" required placeholder="{{ 'Urgent bugs'|t }}">

            <label for="gadget-query">{{ 'Query'|t }}</label>
            <input id="gadget-query" class="field field--code" type="text" name="query" maxlength="1000"
                   placeholder="type = bug AND priority = urgent AND category != done">

            <div class="form__row">
                <div>
                    <label for="gadget-kind">{{ 'Show'|t }}</label>
                    <select id="gadget-kind" class="field" name="kind">
                        <option value="list">{{ 'The tickets'|t }}</option>
                        <option value="count">{{ 'How many'|t }}</option>
                        <option value="breakdown">{{ 'How they split'|t }}</option>
                    </select>
                </div>
                <div>
                    <label for="gadget-group">{{ 'Split by'|t }}</label>
                    <select id="gadget-group" class="field" name="group_by">
                        {% for group in gadget_groups %}
                            <option value="{{ group }}">{{ group|capitalize|t }}</option>
                        {% endfor %}
                    </select>
                </div>
            </div>
            <p class="hint">{{ 'Split by is for “How they split”. Leave the query empty for every ticket you can see.'|t }}</p>
            <div class="form__actions">
                <button class="button button--primary" type="submit">{{ 'Add'|t }}</button>
            </div>
        </form>
    </details>
</div>
