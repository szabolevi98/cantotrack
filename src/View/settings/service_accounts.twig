{% extends 'layout.twig' %}

{% block title %}{{ 'Service accounts'|t }} — {{ app_name }}{% endblock %}
{% block heading %}{{ 'Service accounts'|t }}{% endblock %}
{% block subheading %}<p class="content__sub">{{ 'Accounts for programs rather than people — a webshop, a CI server — so that they do not use somebody’s own token, and keep working when that somebody leaves.'|t }}</p>{% endblock %}

{% block actions %}
    <a class="button" href="{{ url('/help/api') }}"><i class="bi bi-journal-code" aria-hidden="true"></i> {{ 'API documentation'|t }}</a>
{% endblock %}

{% block content %}
    <section class="card card--flush">
        {% if accounts is empty %}
            <p class="card__empty">{{ 'No service accounts yet.'|t }}</p>
        {% else %}
            <table class="table">
                <thead><tr>
                    <th>{{ 'Name'|t }}</th><th>{{ 'Role'|t }}</th><th>{{ 'Mentioned as'|t }}</th>
                    <th class="table__number">{{ 'Tokens'|t }}</th><th>{{ 'Last used'|t }}</th><th></th>
                </tr></thead>
                <tbody>
                {% for account in accounts %}
                    <tr class="{{ account.is_active ? '' : 'row--muted' }}">
                        <td>
                            <i class="bi bi-robot" aria-hidden="true"></i> <a href="{{ url('/settings/service-accounts/' ~ account.id) }}">{{ account.name }}</a>
                            {% if not account.is_active %}<span class="badge badge--muted">{{ 'Switched off'|t }}</span>{% endif %}
                        </td>
                        <td>{{ account.role == 'guest' ? 'Reads and comments'|t : 'Member'|t }}</td>
                        <td><code>@{{ account.handle }}</code></td>
                        <td class="table__number">{{ account.token_count }}</td>
                        <td>{{ account.last_used_at ? account.last_used_at|day : 'Never'|t }}</td>
                        <td class="table__number"><a href="{{ url('/settings/service-accounts/' ~ account.id) }}">{{ 'Open'|t }}</a></td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        {% endif %}
    </section>

    <section class="card card--narrow">
        <h2 class="card__title">{{ 'Make a service account'|t }}</h2>
        <form method="post" action="{{ url('/settings/service-accounts') }}">
            <input type="hidden" name="_token" value="{{ csrf_token }}">
            <div class="form__row">
                <div>
                    <label for="service_name">{{ 'What uses it'|t }}</label>
                    <input id="service_name" class="field" type="text" name="name" maxlength="120" required placeholder="{{ 'GitLab CI'|t }}">
                </div>
                <div>
                    <label for="service_role">{{ 'May'|t }}</label>
                    <select id="service_role" class="field" name="role">
                        <option value="member">{{ 'Change the work, like a member'|t }}</option>
                        <option value="guest">{{ 'Only read and comment, on the projects it is added to'|t }}</option>
                    </select>
                </div>
            </div>
            <p class="hint">{{ 'Its name is what the tickets it makes and the comments it writes are signed with. It cannot sign in with a password, is not offered as an assignee, and is never notified.'|t }}</p>
            <div class="form__actions">
                <button class="button button--primary" type="submit">{{ 'Make it'|t }}</button>
            </div>
        </form>
    </section>
{% endblock %}
