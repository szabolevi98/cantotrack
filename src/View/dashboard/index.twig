{% extends 'layout.twig' %}
{% import 'common/macros.twig' as ui %}

{% block title %}{{ 'Dashboard'|t }} — {{ app_name }}{% endblock %}
{# Greeted by what they asked to be called, or by their whole name — never by
   the first word of it, which in a Hungarian name is the surname. #}
{% block heading %}{{ 'Hello, {name}'|t({name: current_user.short_name ?: current_user.name}) }}{% endblock %}
{% block subheading %}<p class="content__sub">{{ editing ? 'Drag the pieces where you want them, or change what is on the page.'|t : 'What is on your plate today.'|t }}</p>{% endblock %}

{% block actions %}
    {% if editing %}
        <a class="button button--primary" href="{{ url('/') }}"><i class="bi bi-check-lg" aria-hidden="true"></i> {{ 'Done'|t }}</a>
    {% else %}
        <a class="button" href="{{ url('/?edit=1') }}"><i class="bi bi-sliders" aria-hidden="true"></i> {{ 'Customize'|t }}</a>
        {% if can_work %}<a class="button button--primary" href="{{ url('/tickets/create') }}">{{ 'New ticket'|t }}</a>{% endif %}
    {% endif %}
{% endblock %}

{#
    The dashboard: two columns of pieces, each where the person put it. In
    the customizing mode every piece can be dragged, moved a step with its
    buttons, changed or taken off, and the panel above offers more.
#}
{% block content %}
    {% if editing %}{% include 'dashboard/editor.twig' %}{% endif %}

    <div class="dash{{ editing ? ' dash--editing' : '' }}" data-dashboard{% if editing %} data-arrange-url="{{ url('/dashboard/layout') }}"{% endif %}>
        {% for area, pieces in {main: main, side: side} %}
            <div class="dash__column dash__column--{{ area }}" data-area="{{ area }}"
                 aria-label="{{ area == 'main' ? 'The main column'|t : 'The side column'|t }}">
                {% for piece in pieces %}
                    {% include 'dashboard/piece.twig' with {piece: piece, first: loop.first, last: loop.last, area: area} %}
                {% endfor %}
                {% if editing %}
                    <p class="dash__drop muted">{{ pieces is empty ? 'Drag a piece here.'|t : '' }}</p>
                {% elseif pieces is empty and area == 'main' %}
                    <p class="card card__empty">{{ 'Nothing on your dashboard.'|t }} <a href="{{ url('/?edit=1') }}">{{ 'Customize it'|t }}</a></p>
                {% endif %}
            </div>
        {% endfor %}
    </div>
{% endblock %}
