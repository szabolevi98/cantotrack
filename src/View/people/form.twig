{% extends 'layout.twig' %}

{% set editing = person is not null and person.id is defined and person.id %}

{% block title %}{{ editing ? 'Edit person'|t : 'Add somebody'|t }} — {{ app_name }}{% endblock %}
{% block heading %}{{ editing ? 'Edit {name}'|t({name: person.name}) : 'Add somebody'|t }}{% endblock %}

{% block content %}
    {% if error %}<p class="flash flash--danger">{{ error }}</p>{% endif %}

    <section class="card card--narrow">
        <form method="post" action="{{ editing ? url('/people/' ~ person.id) : url('/people/create') }}">
            <input type="hidden" name="_token" value="{{ csrf_token }}">

            <label for="name">{{ 'Name'|t }}</label>
            <input id="name" class="field" type="text" name="name" value="{{ person.name|default('') }}"
                   maxlength="120" required autofocus>

            <label for="email">{{ 'Email address'|t }}</label>
            <input id="email" class="field" type="email" name="email" value="{{ person.email|default('') }}"
                   maxlength="190" required>
            <p class="hint">{{ 'This is what they sign in with.'|t }}</p>

            <label for="role">{{ 'Role'|t }}</label>
            <select id="role" class="field" name="role">
                <option value="member"{{ person.role|default('member') == 'member' ? ' selected' : '' }}>
                    {{ 'Member — works tickets and logs time'|t }}
                </option>
                <option value="guest"{{ person.role|default('') == 'guest' ? ' selected' : '' }}>
                    {{ 'Guest — reads and comments on the projects they are added to'|t }}
                </option>
                <option value="admin"{{ person.role|default('') == 'admin' ? ' selected' : '' }}>
                    {{ 'Administrator — and sets up projects and people'|t }}
                </option>
            </select>

            {% if editing %}
                <fieldset class="week-hours">
                    <legend>{{ 'Working week, in hours'|t }}</legend>
                    {% for name in ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'] %}
                        <label>
                            <span>{{ name|t }}</span>
                            <input class="field" type="text" inputmode="decimal" name="week[{{ loop.index0 }}]"
                                   value="{{ (week[loop.index0] / 60)|round(2) }}" maxlength="5">
                        </label>
                    {% endfor %}
                </fieldset>
                <p class="hint">{{ 'What the timesheet expects of each day. Part-timers get their own; holidays and days away count as nothing expected.'|t }}</p>

                <label class="check">
                    <input type="checkbox" name="is_active" value="1"{{ person.is_active ? ' checked' : '' }}>
                    {{ 'Active — can sign in'|t }}
                </label>
                <p class="hint">
                    {{ 'Nobody is ever deleted: tickets and worklogs point at them, and the history has to keep making sense. Deactivating takes them off the assignee lists and out of the sign-in.'|t }}
                </p>
            {% else %}
                <p class="hint">
                    {{ 'A password is made when the account is, and shown once on the next page. There is nowhere it can be read again.'|t }}
                </p>
            {% endif %}

            <div class="form__actions">
                <button class="button button--primary" type="submit">{{ editing ? 'Save'|t : 'Create account'|t }}</button>
                <a class="button" href="{{ url('/people') }}">{{ 'Cancel'|t }}</a>
            </div>
        </form>
    </section>

    {% if editing %}
        <section class="card card--narrow">
            <h2 class="card__title">{{ 'New password'|t }}</h2>
            <p class="card__body">
                {{ 'For when {name} has lost theirs. The one they had stops working; whatever they have open stays open.'|t({name: person.name}) }}
            </p>
            <form method="post" action="{{ url('/people/' ~ person.id ~ '/password') }}"
                  data-confirm="{{ 'Give {name} a new password?'|t({name: person.name}) }}">
                <input type="hidden" name="_token" value="{{ csrf_token }}">
                <button class="button" type="submit">{{ 'Make a new password'|t }}</button>
            </form>
        </section>

        {% if person.totp_enabled_at|default(null) %}
            <section class="card card--narrow">
                <h2 class="card__title">{{ 'Two-step sign-in'|t }}</h2>
                <p class="card__body">{{ 'On for {name}. If they have lost their phone and their recovery codes, turn it off; they can set it up again.'|t({name: person.name}) }}</p>
                <form method="post" action="{{ url('/people/' ~ person.id ~ '/two-factor/reset') }}"
                      data-confirm="{{ 'Turn two-step sign-in off for {name}?'|t({name: person.name}) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token }}">
                    <button class="button button--danger" type="submit">{{ 'Turn it off'|t }}</button>
                </form>
            </section>
        {% endif %}
    {% endif %}
{% endblock %}
