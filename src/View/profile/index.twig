{% extends 'layout.twig' %}

{% block title %}{{ 'Your profile'|t }} — {{ app_name }}{% endblock %}
{% block heading %}{{ 'Your profile'|t }}{% endblock %}
{% block subheading %}<p class="content__sub">{{ me.email }}</p>{% endblock %}

{% block content %}
    {% import 'common/macros.twig' as ui %}
    <section class="card card--narrow profile-picture">
        <h2 class="card__title">{{ 'Your picture'|t }}</h2>
        <div class="profile-picture__row">
            {{ ui.face(me.name, me.id, 'avatar avatar--large') }}
            <form method="post" action="{{ url('/profile/avatar') }}" enctype="multipart/form-data">
                <input type="hidden" name="_token" value="{{ csrf_token }}">
                <input class="field" type="file" name="avatar" accept="image/png,image/jpeg,image/webp,image/gif" required aria-label="{{ 'Picture'|t }}">
                <p class="hint">{{ 'PNG, JPEG, WebP or GIF, up to 5 MB. The middle square of it is used.'|t }}</p>
                <button class="button button--small" type="submit">{{ 'Upload'|t }}</button>
            </form>
            {% if me.avatar %}
                <form method="post" action="{{ url('/profile/avatar/delete') }}">
                    <input type="hidden" name="_token" value="{{ csrf_token }}">
                    <button class="link-button link-button--text" type="submit">{{ 'Remove the picture'|t }}</button>
                </form>
            {% endif %}
        </div>
    </section>

    <section class="card card--narrow">
        <h2 class="card__title">{{ 'About you'|t }}</h2>
        {% if error %}<p class="flash flash--danger">{{ error }}</p>{% endif %}

        <form method="post" action="{{ url('/profile') }}">
            <input type="hidden" name="_token" value="{{ csrf_token }}">

            <label for="name">{{ 'Name'|t }}</label>
            <input id="name" class="field" type="text" name="name" value="{{ me.name }}" maxlength="120" required>

            <label for="short_name">{{ 'What should we call you?'|t }}</label>
            <input id="short_name" class="field" type="text" name="short_name" value="{{ me.short_name }}"
                   maxlength="60">
            <p class="hint">{{ 'Used where the application talks to you, like the greeting on the dashboard. Left empty, it uses your whole name.'|t }}</p>

            <div class="form__row">
                <div>
                    <label for="locale">{{ 'Language'|t }}</label>
                    <select id="locale" class="field" name="locale">
                        {% for code, label in locales %}
                            <option value="{{ code }}"{{ (me.locale ?: locale) == code ? ' selected' : '' }}>{{ label }}</option>
                        {% endfor %}
                    </select>
                </div>

                <div>
                    <label for="theme">{{ 'Appearance'|t }}</label>
                    <select id="theme" class="field" name="theme">
                        {% for value, label in {system: 'Same as the system', light: 'Light', dark: 'Dark'} %}
                            <option value="{{ value }}"{{ me.theme == value ? ' selected' : '' }}>{{ label|t }}</option>
                        {% endfor %}
                    </select>
                </div>
            </div>

            <div class="form__actions">
                <button class="button button--primary" type="submit">{{ 'Save'|t }}</button>
            </div>
        </form>
    </section>

    <section class="card card--narrow">
        <h2 class="card__title">{{ 'Password'|t }}</h2>
        {% if password_error %}<p class="flash flash--danger">{{ password_error }}</p>{% endif %}
        <p class="card__body">
            {% if me.password_changed_at %}
                {{ 'Last changed on {day}.'|t({day: me.password_changed_at|day}) }}
            {% else %}
                {{ 'You are still using the password you were given. Choose one of your own — the person who made the account has seen that one.'|t }}
            {% endif %}
        </p>

        <form method="post" action="{{ url('/profile/password') }}">
            <input type="hidden" name="_token" value="{{ csrf_token }}">
            {# The address, so a password manager files the new password under
               the right account. #}
            <input type="email" name="username" value="{{ me.email }}" autocomplete="username" hidden>

            <label for="current_password">{{ 'Current password'|t }}</label>
            <input id="current_password" class="field" type="password" name="current_password"
                   autocomplete="current-password" required>

            <div class="form__row">
                <div>
                    <label for="new_password">{{ 'New password'|t }}</label>
                    <input id="new_password" class="field" type="password" name="new_password"
                           autocomplete="new-password" minlength="10" required>
                </div>
                <div>
                    <label for="new_password_again">{{ 'The new one again'|t }}</label>
                    <input id="new_password_again" class="field" type="password" name="new_password_again"
                           autocomplete="new-password" minlength="10" required>
                </div>
            </div>
            <p class="hint">{{ 'At least 10 characters. A few ordinary words strung together is stronger than a short jumble, and easier to type.'|t }}</p>

            <div class="form__actions">
                <button class="button button--primary" type="submit">{{ 'Change password'|t }}</button>
            </div>
        </form>
    </section>

    {# Signed in for a year from the last click: this is the way out for a
       laptop left somewhere, or a computer somebody else uses too. #}
    <section class="card card--narrow">
        <h2 class="card__title">{{ 'Where you are signed in'|t }}</h2>
        <p class="card__body">{{ 'You stay signed in for a year from the last time you used CantoTrack in a browser. Changing your password signs you out everywhere else, the mobile app included; so does this button, without a new password.'|t }}</p>
        <form class="card__body" method="post" action="{{ url('/profile/sessions/end') }}"
              data-confirm="{{ 'Sign out of every other browser?'|t }}">
            <input type="hidden" name="_token" value="{{ csrf_token }}">
            <button class="button" type="submit"><i class="bi bi-box-arrow-right" aria-hidden="true"></i> {{ 'Sign out everywhere else'|t }}</button>
        </form>
    </section>

    <section class="card card--narrow">
        <h2 class="card__title">{{ 'Your calendar'|t }}</h2>
        <p class="card__body">{{ 'Paste the private address of your calendar in iCal format, and the week’s calendar offers your meetings as entries — one click from logged. Google Calendar: Settings → your calendar → “Secret address in iCal format”. Outlook: Settings → Calendar → Shared calendars → Publish a calendar → ICS.'|t }}</p>
        <form method="post" action="{{ url('/profile/calendar') }}">
            <input type="hidden" name="_token" value="{{ csrf_token }}">
            {% if me.calendar_feed %}
                <p class="hint">{{ 'Read from {host}.'|t({host: me.calendar_feed|split('/')[2]|default('')}) }}</p>
            {% endif %}
            <input class="field field--code" type="url" name="calendar_feed" placeholder="https://calendar.google.com/calendar/ical/…/basic.ics"
                   aria-label="{{ 'Calendar address'|t }}" autocomplete="off">
            <div class="form__actions">
                <button class="button" type="submit">{{ me.calendar_feed ? 'Replace'|t : 'Save'|t }}</button>
                {% if me.calendar_feed %}
                    <button class="button button--danger" type="submit" name="calendar_feed" value="">{{ 'Stop reading it'|t }}</button>
                {% endif %}
            </div>
        </form>
    </section>

    {#
        What the person hears about: each kind of thing in the application
        and by email, in the application only, or not at all — and the
        morning digest.
    #}
    {% set ways = notify_ways|default({}) %}
    <section class="card card--narrow" id="notifications">
        <h2 class="card__title">{{ 'What you hear about'|t }}</h2>
        <p class="hint">{{ 'An email waits a couple of minutes, and what else happens to the same ticket in the meantime goes in it too. What you have read here by then is left out. A ticket you do not want to hear about can be muted on its page.'|t }}</p>
        <form method="post" action="{{ url('/profile/notifications') }}">
            <input type="hidden" name="_token" value="{{ csrf_token }}">
            <table class="table table--compact notify-table">
                <thead>
                    <tr>
                        <th></th>
                        <th>{{ 'Here and by email'|t }}</th>
                        <th>{{ 'Here only'|t }}</th>
                        <th>{{ 'Not at all'|t }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% for kind, label in {
                        assigned: 'A ticket is given to me',
                        mentioned: 'Somebody mentions me',
                        status: 'Something I follow moves on',
                        commented: 'Somebody comments on something I follow',
                        changes: 'Other changes to what I follow'
                    } %}
                        <tr>
                            <th scope="row">{{ label|t }}</th>
                            {% for way in ['email', 'app', 'off'] %}
                                <td><input type="radio" name="ways[{{ kind }}]" value="{{ way }}"{{ ways[kind]|default('email') == way ? ' checked' : '' }}
                                           aria-label="{{ label|t }}: {{ {email: 'Here and by email', app: 'Here only', off: 'Not at all'}[way]|t }}"></td>
                            {% endfor %}
                        </tr>
                    {% endfor %}
                </tbody>
            </table>

            <label class="check">
                <input type="checkbox" name="digest" value="1"{{ me.digest_query ? ' checked' : '' }}>
                {{ 'Send me a digest on working-day mornings'|t }}
            </label>
            <label for="digest_query">{{ 'What it lists'|t }}</label>
            <input id="digest_query" class="field field--code" type="text" name="digest_query" maxlength="1000"
                   value="{{ me.digest_query ?: default_digest|default('') }}">
            <p class="hint">{{ 'A query, as on the ticket list. The digest also lists what of yours is due this week, and how many notifications are unread.'|t }}</p>

            <div class="form__actions">
                <button class="button button--primary" type="submit">{{ 'Save'|t }}</button>
            </div>
        </form>
    </section>

    {#
        The other way round: one's own dates, for one's calendar to subscribe
        to. The address is the key — shown once, and a new one undoes it.
    #}
    <section class="card card--narrow" id="dates">
        <h2 class="card__title">{{ 'Your dates in your calendar'|t }}</h2>
        <p class="card__body">{{ 'A private address your calendar subscribes to: the days your open tickets are due, the releases coming and the last days of the sprints running, updated as they change. Google Calendar: Other calendars → From URL. Outlook: Add calendar → Subscribe from web.'|t }}</p>
        {% if new_calendar_address|default(null) %}
            <p class="flash flash--success">{{ 'Here it is. Copy it now: it is not shown again, and anybody who has it sees these dates.'|t }}</p>
            <input class="field field--code" type="text" value="{{ new_calendar_address }}" readonly data-select-on-focus aria-label="{{ 'Calendar address'|t }}">
        {% elseif me.calendar_export_hash %}
            <p class="hint">{{ 'You have an address. It was shown once; make a new one if you need it again — the old one stops working.'|t }}</p>
        {% endif %}
        <form method="post" action="{{ url('/profile/calendar-export') }}">
            <input type="hidden" name="_token" value="{{ csrf_token }}">
            <div class="form__actions">
                <button class="button" type="submit">{{ me.calendar_export_hash ? 'Make a new address'|t : 'Make an address'|t }}</button>
                {% if me.calendar_export_hash %}
                    <button class="button button--danger" type="submit" name="stop" value="1">{{ 'Stop it working'|t }}</button>
                {% endif %}
            </div>
        </form>
    </section>

    <section class="card card--narrow">
        <h2 class="card__title">{{ 'Two-step sign-in'|t }}</h2>
        <p class="card__body">
            {{ me.totp_enabled_at ? 'On: signing in also takes a code from your phone.'|t : 'Off: the password alone signs you in.'|t }}
        </p>
        <a class="button" href="{{ url('/profile/two-factor') }}">{{ me.totp_enabled_at ? 'Manage'|t : 'Set it up'|t }}</a>
    </section>

    <section class="card card--narrow">
        <h2 class="card__title">{{ 'Access tokens'|t }}</h2>
        <p class="card__body">{{ 'For scripts and other programs that use the API on your behalf.'|t }}</p>
        <a class="button" href="{{ url('/profile/tokens') }}">{{ 'Manage tokens'|t }}</a>
    </section>
{% endblock %}
