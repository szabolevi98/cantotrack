# PHP application (CantoTrack)
/vendor/

# Composer itself lives in the project rather than on the machine, so it is not
# part of the repository either.
/composer.phar

# EVERY config, not only `config.ini`.
#
# A second config file appears the moment a copy of the live database has to be
# migrated locally, and every one of them holds the database password. Excluding
# them by name would protect the first and quietly let the second through, and a
# push takes it from there. The `.dist` is the exception: that is the shape of
# the file, with no secrets in it.
/config/*.ini
!/config/config.ini.dist

/var/cache/*
!/var/cache/.gitkeep
/var/log/*
!/var/log/.gitkeep
/var/sessions/*
!/var/sessions/.gitkeep
/var/uploads/*
!/var/uploads/.gitkeep
/var/mail/*
!/var/mail/.gitkeep

# JetBrains IDE
.idea/
.vscode/

# Log files
*.log

# Generated by macOS
.DS_Store

# Generated by Windows
Thumbs.db
