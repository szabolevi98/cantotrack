{% extends 'layout.twig' %}
{% set editing = page is not null %}

{% block title %}{{ editing ? 'Edit {title}'|t({title: page.title}) : 'New page'|t }} — {{ app_name }}{% endblock %}
{% block heading %}{{ editing ? 'Edit {title}'|t({title: page.title}) : 'New page'|t }}{% endblock %}
{% block subheading %}<p class="content__sub">{{ 'In {project}'|t({project: project.name ~ ' (' ~ project.code ~ ')'}) }}</p>{% endblock %}

{% block content %}
    {% if error %}<p class="flash flash--danger">{{ error }}</p>{% endif %}

    <section class="card">
        <form method="post" action="{{ editing ? url('/pages/' ~ page.id) : url('/projects/' ~ project.id ~ '/pages/create') }}"
              data-page-form data-preview-url="{{ url('/projects/' ~ project.id ~ '/pages/preview') }}">
            <input type="hidden" name="_token" value="{{ csrf_token }}">
            {% if editing %}<input type="hidden" name="version" value="{{ values.version|default(page.version) }}">{% endif %}

            <div class="form__row form__row--title">
                <div>
                    <label for="title">{{ 'Title'|t }}</label>
                    <input id="title" class="field" type="text" name="title" value="{{ values.title|default('') }}" maxlength="200" required {{ editing ? '' : 'autofocus' }}>
                </div>
                <div>
                    <label for="parent_id">{{ 'Under'|t }}</label>
                    <select id="parent_id" class="field" name="parent_id">
                        <option value="">{{ 'The top of the project'|t }}</option>
                        {% for parent in parents %}
                            <option value="{{ parent.id }}"{{ values.parent_id|default(0) == parent.id ? ' selected' : '' }}>{{ '— '|repeat(parent.depth) }}{{ parent.title }}</option>
                        {% endfor %}
                    </select>
                </div>
            </div>

            <div class="page-editor">
                <nav class="segmented page-editor__tabs" aria-label="{{ 'Write or look'|t }}">
                    <button type="button" class="segmented__item is-active" data-page-tab="write">{{ 'Write'|t }}</button>
                    <button type="button" class="segmented__item" data-page-tab="preview">{{ 'Preview'|t }}</button>
                </nav>
                <label class="visually-hidden" for="body">{{ 'Text'|t }}</label>
                <textarea id="body" class="field field--code page-editor__text" name="body" rows="22" data-page-text>{{ values.body|default('') }}</textarea>
                <div class="card page-body page-editor__preview" data-page-preview hidden></div>
            </div>
            <p class="hint">{{ 'Markdown: # headings, **bold**, lists, tables, `code`. CT-14 links to that ticket, [[Another page]] to a page of the project, and a line {{tickets category != done ORDER BY priority DESC}} shows those tickets, read fresh each time.'|t }}</p>

            <div class="form__actions">
                <button class="button button--primary" type="submit">{{ editing ? 'Save'|t : 'Create page'|t }}</button>
                <a class="button" href="{{ editing ? url('/pages/' ~ page.id) : url('/projects/' ~ project.id ~ '/pages') }}">{{ 'Cancel'|t }}</a>
            </div>
        </form>
    </section>
{% endblock %}
