{% extends 'layout.twig' %}
{% import 'common/macros.twig' as ui %}

{% block title %}{{ project.code }} — {{ app_name }}{% endblock %}
{% block heading %}{{ project.name }}{% endblock %}

{% block subheading %}
    <p class="content__sub">
        <span class="project__code">{{ project.code }}</span>
        {% if project.is_archived %}<span class="badge badge--muted">Archived</span>{% endif %}
        {% if project.description %}{{ project.description }}{% endif %}
    </p>
{% endblock %}

{% block actions %}
    <a class="button" href="{{ url('/projects/' ~ project.id ~ '/epics/create') }}">New epic</a>
    <a class="button button--primary" href="{{ url('/tickets/create?project=' ~ project.id) }}">New ticket</a>
    {% if is_admin %}
        <a class="button" href="{{ url('/projects/' ~ project.id ~ '/edit') }}">Settings</a>
    {% endif %}
{% endblock %}

{% block content %}
    {% if epics is not empty %}
        <section class="card">
            <h2 class="card__title">Epics</h2>
            <div class="epics">
                {% for epic in epics %}
                    {% set total = epic.ticket_count|default(0) %}
                    {% set done = epic.done_count|default(0) %}
                    <a class="epic{{ epic.is_done ? ' epic--done' : '' }}" href="{{ url('/epics/' ~ epic.id) }}">
                        <strong>{{ epic.title }}</strong>
                        <span class="epic__meta">
                            {{ total > 0 ? done ~ ' of ' ~ total ~ ' done' : 'No tickets yet' }}
                        </span>
                        {% if total > 0 %}
                            <span class="bar"><span class="bar__fill" style="width: {{ (done / total * 100)|round }}%"></span></span>
                        {% endif %}
                    </a>
                {% endfor %}
            </div>
        </section>
    {% endif %}

    {#
        The board. Five columns, each one a list rather than anything draggable:
        a select moves a ticket, which works with a keyboard, on a phone, and
        without a line of JavaScript.
    #}
    <div class="board">
        {% for status in statuses %}
            {% set over = status.wip_limit and status.ticket_count > status.wip_limit %}
            <section class="board__column{{ over ? ' board__column--over' : '' }}">
                <header class="board__head">
                    {{ ui.status(status.name, status.colour) }}
                    {# A limit is shown as "3 / 4", and over it the column says so
                       — it does not refuse the ticket. #}
                    <span class="board__count"{{ over ? ' title="' ~ ('Over the limit of {count}'|t({count: status.wip_limit})) ~ '"' : '' }}>
                        {{ status.ticket_count }}{% if status.wip_limit %} / {{ status.wip_limit }}{% endif %}
                    </span>
                </header>

                <div class="board__cards">
                    {% for ticket in board[status.id] %}
                        <article class="ticket-card">
                            <div class="ticket-card__top">
                                <span class="ticket-card__key">{{ ui.type_icon(ticket.type) }} {{ ui.ticket_key(ticket) }}</span>
                                {{ ui.priority(ticket.priority) }}
                            </div>

                            <a class="ticket-card__title" href="{{ url('/tickets/' ~ ticket.id) }}">{{ ticket.title }}</a>

                            {% if ticket.epic_title or ticket.label_names %}
                                <div class="ticket-card__tags">
                                    {% if ticket.epic_title %}<span class="ticket-card__epic">{{ ticket.epic_title }}</span>{% endif %}
                                    {{ ui.labels(ticket.label_names|lines, false) }}
                                </div>
                            {% endif %}

                            <div class="ticket-card__foot">
                                {{ ui.person(ticket.assignee_name) }}
                                <span class="ticket-card__meta">
                                    {{ ui.due(ticket.due_on, ticket.status_category == 'done') }}
                                    {% if ticket.story_points is not null %}
                                        <span class="points" title="{{ 'Story points'|t }}">{{ ticket.story_points }}</span>
                                    {% endif %}
                                    {% if ticket.logged_minutes > 0 %}
                                        <span class="muted">{{ ticket.logged_minutes|duration }}</span>
                                    {% endif %}
                                </span>
                            </div>

                            {{ ui.move(ticket, statuses, '/projects/' ~ project.id) }}
                        </article>
                    {% else %}
                        <p class="board__empty">—</p>
                    {% endfor %}

                    {% if more[status.id]|default(0) > 0 %}
                        {# The done column only ever grows, so it shows the latest
                           and says how many more there are rather than drawing
                           two years of finished work on every visit. #}
                        <a class="board__more" href="{{ url('/tickets?project=' ~ project.id ~ '&status=' ~ status.id) }}">
                            {{ plural('and {count} more', 'and {count} more', more[status.id]) }}
                        </a>
                    {% endif %}
                </div>
            </section>
        {% endfor %}
    </div>
{% endblock %}
