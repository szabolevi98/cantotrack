{% extends 'layout.twig' %}
{% import 'common/macros.twig' as ui %}

{% block title %}{{ epic.title }} — {{ app_name }}{% endblock %}
{% block heading %}{{ epic.title }}{% endblock %}

{% block subheading %}
    <p class="content__sub">
        {{ 'Epic in'|t }} <a href="{{ url('/projects/' ~ project.id) }}">{{ project.name }}</a>
        {% if epic.is_done %}<span class="badge badge--done">{{ 'Done'|t }}</span>{% endif %}
        {% if epic.starts_on or epic.ends_on %}· {{ epic.starts_on ? epic.starts_on|day : '…' }} — {{ epic.ends_on ? epic.ends_on|day : '…' }}{% endif %}
        · <a href="{{ url('/projects/' ~ project.id ~ '/roadmap') }}">{{ 'On the roadmap'|t }}</a>
    </p>
{% endblock %}

{% block actions %}
    {% if can_work %}
        <a class="button" href="{{ url('/tickets/create?project=' ~ project.id ~ '&epic=' ~ epic.id) }}">{{ 'New ticket'|t }}</a>
        <a class="button" href="{{ url('/epics/' ~ epic.id ~ '/edit') }}">{{ 'Edit'|t }}</a>
    {% endif %}
{% endblock %}

{% block content %}
    {% if epic.description %}
        <section class="card">
            <p class="card__body prose">{{ epic.description|nl2br }}</p>
        </section>
    {% endif %}

    <section class="card card--flush">
        {% if tickets is empty %}
            <p class="card__empty">{{ 'Nothing in this epic yet.'|t }}</p>
        {% else %}
            <table class="table">
                <thead>
                <tr>
                    <th class="table__key">{{ 'Ticket'|t }}</th>
                    <th>{{ 'Title'|t }}</th>
                    <th>{{ 'Status'|t }}</th>
                    <th>{{ 'Assignee'|t }}</th>
                    <th class="table__number">{{ 'Logged'|t }}</th>
                </tr>
                </thead>
                <tbody>
                {% for ticket in tickets %}
                    <tr>
                        <td>{{ ui.ticket_key(ticket) }}</td>
                        <td>
                            <a href="{{ url('/tickets/' ~ ticket.id) }}">{{ ticket.title }}</a>{{ ui.family(ticket) }}
                            {{ ui.priority(ticket.priority) }}
                        </td>
                        <td>{{ ui.status(ticket.status_name, ticket.status_colour) }}</td>
                        <td>{{ ui.person(ticket.assignee_name, ticket.assignee_id) }}</td>
                        <td class="table__number">{{ ticket.logged_minutes > 0 ? ticket.logged_minutes|duration : '—' }}</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        {% endif %}
    </section>
{% endblock %}
