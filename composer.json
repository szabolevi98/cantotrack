{
    "name": "szabolevi98/cantotrack",
    "description": "An issue tracker with time logging: projects, epics, tickets and timesheets.",
    "license": "MIT",
    "require": {
        "php": ">=8.4",
        "ext-curl": "*",
        "ext-dom": "*",
        "ext-fileinfo": "*",
        "ext-gd": "*",
        "ext-iconv": "*",
        "ext-mbstring": "*",
        "ext-pdo_mysql": "*",
        "ext-zip": "*",
        "bacon/bacon-qr-code": "^3.0",
        "dompdf/dompdf": "^3.1",
        "league/commonmark": "^2.6",
        "symfony/event-dispatcher": "^7.3",
        "symfony/mailer": "^7.3",
        "symfony/mime": "^7.3",
        "twig/twig": "^3.21"
    },
    "autoload": {
        "psr-4": {
            "CantoTrack\\": "src/"
        },
        "files": [
            "src/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "CantoTrack\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit=1G",
        "style": "php-cs-fixer fix --dry-run --diff",
        "check": ["@style", "@analyse", "@test"]
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.4.0"
        },
        "platform-check": false
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.64",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5"
    }
}
