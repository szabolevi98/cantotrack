{#
    The pieces that appear on more than one page: a ticket's name, its status,
    its priority and who it belongs to.

    They are macros rather than copied markup because a status pill that reads
    "In progress" on one page and "in_progress" on another is the kind of thing
    nobody reports and everybody notices.
#}

{#
    A column's name. Columns are named by whoever set the project up, so the
    name is data — but the five every project starts with are English words
    the catalogue knows, and they read in the viewer's language until somebody
    renames them.
#}
{% macro status_label(name) %}
    {{- name|t -}}
{% endmacro %}

{% macro status(name, colour) %}
    <span class="badge badge--status badge--{{ colour|default('slate') }}">{{ name|t }}</span>
{% endmacro %}

{# The three kinds of column, which are the application's own words. #}
{% macro category_label(value) %}
    {%- set labels = { todo: 'Not started', in_progress: 'In progress', done: 'Done' } -%}
    {{- (labels[value]|default(value))|t -}}
{% endmacro %}

{% macro priority_label(value) %}
    {%- set labels = { low: 'Low', normal: 'Normal', high: 'High', urgent: 'Urgent' } -%}
    {{- (labels[value]|default(value))|t -}}
{% endmacro %}

{% macro priority(value) %}
    {# Normal is the priority most tickets have; drawing a pill for it would put
       a label on every row that says nothing. #}
    {% if value != 'normal' %}
        <span class="badge badge--priority badge--{{ value }}">{{ _self.priority_label(value) }}</span>
    {% endif %}
{% endmacro %}

{#
    Where a ticket stands among its own: on a subtask, the ticket it is a step
    of; on a ticket broken into subtasks, how many of them are done.
#}
{% macro family(ticket) %}
    {%- if ticket.parent_id|default(null) -%}
        <a class="family" href="{{ url('/tickets/' ~ ticket.parent_id) }}" title="{{ 'A subtask of {key}: {title}'|t({key: ticket.project_code ~ '-' ~ ticket.parent_number, title: ticket.parent_title}) }}">↳ {{ ticket.project_code }}-{{ ticket.parent_number }}</a>
    {%- elseif ticket.subtask_count|default(0) > 0 -%}
        <span class="family{{ ticket.subtasks_done == ticket.subtask_count ? ' family--done' : '' }}" title="{{ '{done} of {count} subtasks done'|t({done: ticket.subtasks_done, count: ticket.subtask_count}) }}">☑ {{ ticket.subtasks_done }}/{{ ticket.subtask_count }}</span>
    {%- endif -%}
{% endmacro %}

{% macro ticket_key(ticket) %}
    <a class="ticket-key" href="{{ url('/tickets/' ~ ticket.id) }}">{{ ticket.project_code }}-{{ ticket.number }}</a>
{% endmacro %}

{#
    Somebody's face: their picture when they have one, their initials when
    not. The picture is decoration beside the name, so it says nothing to a
    screen reader.
#}
{% macro face(name, id = null, class = 'person__mark') %}
    {%- set picture = avatar_url(id) -%}
    {%- if picture -%}
        <img class="{{ class }} face" src="{{ picture }}" alt="" width="24" height="24" loading="lazy">
    {%- else -%}
        <span class="{{ class }}" aria-hidden="true">{{ name|initials }}</span>
    {%- endif -%}
{% endmacro %}

{% macro person(name, id = null) %}
    {% if name %}
        <span class="person">{{ _self.face(name, id) }}{{ name }}</span>
    {% else %}
        <span class="muted">{{ 'Unassigned'|t }}</span>
    {% endif %}
{% endmacro %}

{#
    Page links under a list. `query` is the list's query string without the
    page, so every link keeps the filters it was drawn under.
#}
{% macro pages(base, query, page, pages) %}
    {% if pages > 1 %}
        {% set joiner = query ? '?' ~ query ~ '&' : '?' %}
        <nav class="pager" aria-label="{{ 'Pages'|t }}">
            {% if page > 1 %}
                <a class="button button--small" href="{{ url(base ~ joiner ~ 'page=' ~ (page - 1)) }}" rel="prev">← {{ 'Previous'|t }}</a>
            {% endif %}
            <span class="pager__where">{{ 'Page {page} of {pages}'|t({page: page, pages: pages}) }}</span>
            {% if page < pages %}
                <a class="button button--small" href="{{ url(base ~ joiner ~ 'page=' ~ (page + 1)) }}" rel="next">{{ 'Next'|t }} →</a>
            {% endif %}
        </nav>
    {% endif %}
{% endmacro %}

{#
    The one-click move along the board. A form rather than a link, because it
    changes something — and a link that changes something is a link a browser or
    a crawler will follow on its own.
#}
{% macro move(ticket, statuses, back) %}
    <form class="move" method="post" action="{{ url('/tickets/' ~ ticket.id ~ '/status') }}">
        <input type="hidden" name="_token" value="{{ csrf_token }}">
        <input type="hidden" name="back" value="{{ back }}">
        <select class="field field--inline move__select" name="status" data-autosubmit
                aria-label="{{ 'Status of {key}'|t({key: ticket.project_code ~ '-' ~ ticket.number}) }}">
            {% for status in statuses %}
                <option value="{{ status.id }}"{{ ticket.status_id == status.id ? ' selected' : '' }}>{{ status.name|t }}</option>
            {% endfor %}
        </select>
        {# Without JavaScript the select changes nothing on its own, so the form
           keeps a button that does. With it, the button is hidden until a
           keyboard has changed the select — see data-autosubmit in core.js. #}
        <button class="button button--small autosubmit__button" type="submit">{{ 'Move'|t }}</button>
    </form>
{% endmacro %}

{#
    One entry of hours, on a ticket's page or on a timesheet — with the two
    things its owner can do to it: correct it, or take it out.

    The correction opens in place. Entries used to be deletable but not
    editable (the route existed; no form ever pointed at it), so a typo in
    the duration meant deleting the entry and typing it all again.

    `context` is 'ticket' (the row names who and when) or 'timesheet' (it
    names the ticket; the day is the section it sits in).
#}
{% macro log_entry(entry, back, context) %}
    <li class="log">
        <div class="log__what">
            {% if context == 'timesheet' %}
                <a class="ticket-key" href="{{ url('/tickets/' ~ entry.ticket_id) }}">{{ entry.project_code }}-{{ entry.ticket_number }}</a>
                <a href="{{ url('/tickets/' ~ entry.ticket_id) }}">{{ entry.ticket_title }}</a>
            {% else %}
                <strong>{{ entry.user_name }}</strong>
                <span class="muted">{{ entry.work_date|day }}</span>
            {% endif %}
            {% if entry.work_type_name|default(null) %}<span class="tag tag--type">{{ entry.work_type_name }}</span>{% endif %}
            {% if entry.note %}<span class="log__note">{{ entry.note }}</span>{% endif %}
            {% if entry.billable is defined and not entry.billable and entry.project_billable|default(1) %}<span class="tag" title="{{ 'Not billed'|t }}">{{ 'not billed'|t }}</span>{% endif %}
        </div>

        <span class="log__time">{% if entry.started_at|default(null) %}<span class="log__start">{{ entry.started_at|slice(0, 5) }}</span> {% endif %}{{ entry.minutes|duration }}</span>

        {% if entry.user_id == current_user.id or is_admin %}
            <form class="log__delete" method="post" action="{{ url('/worklogs/' ~ entry.id ~ '/delete') }}"
                  data-confirm="{{ 'Delete this {duration} entry?'|t({duration: entry.minutes|duration}) }}">
                <input type="hidden" name="_token" value="{{ csrf_token }}">
                <input type="hidden" name="back" value="{{ back }}">
                <button class="link-button" type="submit" title="{{ 'Delete this entry'|t }}"
                        aria-label="{{ 'Delete this entry'|t }}">×</button>
            </form>

            <details class="log__edit">
                <summary class="link-button link-button--text">{{ 'Edit'|t }}</summary>
                <form class="log-form log-form--edit" method="post" action="{{ url('/worklogs/' ~ entry.id) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token }}">
                    <input type="hidden" name="back" value="{{ back }}">

                    <div>
                        <label for="time-{{ entry.id }}">{{ 'How long'|t }}</label>
                        <input id="time-{{ entry.id }}" class="field" type="text" name="time"
                               value="{{ entry.minutes|duration }}" required>
                    </div>

                    <div>
                        <label for="day-{{ entry.id }}">{{ 'Which day'|t }}</label>
                        <input id="day-{{ entry.id }}" class="field" type="date" name="work_date"
                               value="{{ entry.work_date }}" max="{{ 'now'|date('Y-m-d') }}">
                    </div>

                    {% include 'common/work_type_field.twig' with {id: 'type-' ~ entry.id, current: entry.work_type_id|default(null)} %}

                    <div>
                        <label for="start-{{ entry.id }}">{{ 'Started at'|t }}</label>
                        <input id="start-{{ entry.id }}" class="field" type="time" name="started_at" step="300"
                               value="{{ entry.started_at ? entry.started_at|slice(0, 5) : '' }}">
                    </div>

                    <div class="log-form__note">
                        <label for="note-{{ entry.id }}">{{ 'What you did'|t }}</label>
                        <input id="note-{{ entry.id }}" class="field" type="text" name="note" maxlength="500"
                               value="{{ entry.note }}">
                    </div>

                    <label class="check check--inline log-form__billable">
                        <input type="hidden" name="billable_sent" value="1">
                        <input type="checkbox" name="billable" value="1"{{ entry.billable ? ' checked' : '' }}>
                        {{ 'Billable'|t }}
                    </label>

                    <button class="button button--primary" type="submit">{{ 'Save'|t }}</button>
                </form>
            </details>
        {% endif %}
    </li>
{% endmacro %}

{#
    What kind of ticket: a task, a bug or a story. An icon with its name for
    screen readers and a tooltip, drawn inline so it needs no image request and
    takes the colour of its class.
#}
{% macro type_label(type) %}
    {%- set labels = { task: 'Task', bug: 'Bug', story: 'Story' } -%}
    {{- (labels[type]|default('Task'))|t -}}
{% endmacro %}

{% macro type_icon(type) %}
    <span class="type-icon type-icon--{{ type|default('task') }}" title="{{ _self.type_label(type) }}" role="img"
          aria-label="{{ _self.type_label(type) }}">
        {%- if type == 'bug' -%}
            <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><rect width="16" height="16" rx="3"/><circle cx="8" cy="8" r="3.2" fill="#fff"/></svg>
        {%- elseif type == 'story' -%}
            <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><rect width="16" height="16" rx="3"/><path d="M5 3.5h6v9l-3-2.2-3 2.2z" fill="#fff"/></svg>
        {%- else -%}
            <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><rect width="16" height="16" rx="3"/><path d="M4.3 8.3l2.4 2.4 5-5.2" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        {%- endif -%}
    </span>
{% endmacro %}

{# A ticket's labels, each in the colour its name gives it. #}
{% macro labels(names, link) %}
    {% for name in names %}
        {% if link %}
            <a class="label label--{{ name|label_colour }}" href="{{ url('/tickets?label=' ~ name|url_encode) }}">{{ name }}</a>
        {% else %}
            <span class="label label--{{ name|label_colour }}">{{ name }}</span>
        {% endif %}
    {% endfor %}
{% endmacro %}

{#
    When a ticket is due, and whether that is a problem: late (red), within
    three days (amber), or simply a date. A finished ticket is never late.
#}
{% macro due(date, finished) %}
    {% if date %}
        {% set today = 'now'|date('Y-m-d') %}
        {% set soon = 'now'|date_modify('+3 days')|date('Y-m-d') %}
        {% if not finished and date < today %}
            <span class="due due--late" title="{{ 'Overdue'|t }}">{{ date|day }}</span>
        {% elseif not finished and date <= soon %}
            <span class="due due--soon" title="{{ 'Due soon'|t }}">{{ date|day }}</span>
        {% else %}
            <span class="due">{{ date|day }}</span>
        {% endif %}
    {% endif %}
{% endmacro %}

{#
    One line of a ticket's history, in words. The values are the words people
    saw at the time; the ones that are the application's own (a priority, a
    type, the five default columns) are translated, anything typed is not.
#}
{% macro event_line(event) %}
    {%- set who = event.user_name ?: 'Somebody'|t -%}
    {%- set fields = {
        title: 'title', type: 'type', priority: 'priority', assignee: 'assignee', epic: 'epic', parent: 'parent',
        estimate: 'estimate', due: 'due date', points: 'story points', labels: 'labels', description: 'description'
    } -%}
    {%- set field = (fields[event.field]|default(event.field))|t -%}
    {%- set old = event.field in ['priority', 'type', 'status'] ? event.old_value|t : event.old_value -%}
    {%- set new = event.field in ['priority', 'type', 'status'] ? event.new_value|t : event.new_value -%}
    {%- if event.field == 'due' -%}
        {%- set old = event.old_value ? event.old_value|day : null -%}
        {%- set new = event.new_value ? event.new_value|day : null -%}
    {%- endif -%}

    {%- if event.kind == 'created' -%}
        {{ '{who} created the ticket'|t({who: who}) }}
    {%- elseif event.kind == 'status' -%}
        {{ '{who} moved it from {old} to {new}'|t({who: who, old: old, new: new}) }}
    {%- elseif event.kind == 'logged' -%}
        {{ '{who} logged {duration} on {day}'|t({who: who, duration: event.new_value, day: event.old_value|day}) }}
    {%- elseif event.kind == 'attached' -%}
        {{ '{who} attached {name}'|t({who: who, name: event.new_value}) }}
    {%- elseif event.kind == 'detached' -%}
        {{ '{who} removed the attachment {name}'|t({who: who, name: event.old_value}) }}
    {%- elseif event.kind == 'linked' -%}
        {%- set phrases = {blocks: 'blocks', blocked_by: 'is blocked by', relates: 'relates to', duplicates: 'duplicates', duplicated_by: 'is duplicated by'} -%}
        {{ '{who} linked it: {how} {key}'|t({who: who, how: (phrases[event.field]|default(event.field))|t, key: event.new_value}) }}
    {%- elseif event.kind == 'unlinked' -%}
        {{ '{who} removed the link to {key}'|t({who: who, key: event.old_value}) }}
    {%- elseif event.kind == 'commit' -%}
        {{ '{who} mentioned it in a commit'|t({who: who}) }} <code>{{ event.old_value|slice(0, 7) }}</code> {{ event.new_value }}
    {%- elseif event.kind == 'sprint' -%}
        {% if event.new_value %}{{ '{who} put it in {sprint}'|t({who: who, sprint: event.new_value}) }}{% else %}{{ '{who} took it out of {sprint}'|t({who: who, sprint: event.old_value}) }}{% endif %}
    {%- elseif event.field == 'description' -%}
        {{ '{who} edited the description'|t({who: who}) }}
    {%- elseif event.old_value and event.new_value -%}
        {{ '{who} changed the {field} from {old} to {new}'|t({who: who, field: field, old: old, new: new}) }}
    {%- elseif event.new_value -%}
        {{ '{who} set the {field} to {new}'|t({who: who, field: field, new: new}) }}
    {%- else -%}
        {{ '{who} cleared the {field}'|t({who: who, field: field}) }}
    {%- endif -%}
{% endmacro %}
