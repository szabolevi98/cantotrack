{% extends 'layout.twig' %}
{% import 'common/macros.twig' as ui %}

{% block title %}{{ 'People'|t }} — {{ app_name }}{% endblock %}
{% block heading %}{{ 'People'|t }}{% endblock %}
{% block subheading %}<p class="content__sub">{{ 'Who can sign in, and what they may do.'|t }}</p>{% endblock %}

{% block actions %}
    <a class="button button--primary" href="{{ url('/people/create') }}">{{ 'Add somebody'|t }}</a>
{% endblock %}

{% block content %}
    {#
        A password is shown here exactly once, on the page after it was made.
        It lives in the session until this page draws it and not a moment longer,
        so a reload does not put it back on screen.
    #}
    {% if new_password %}
        <section class="card card--handover">
            <h2 class="card__title">{{ 'Hand this over'|t }}</h2>
            <p class="card__body">
                {{ 'It is not stored in readable form anywhere, so this is the only time it can be read. If it goes missing, make a new one.'|t }}
            </p>
            <dl class="facts">
                <dt>{{ 'Signs in with'|t }}</dt>
                <dd>{{ new_password.email }}</dd>
                <dt>{{ 'Password'|t }}</dt>
                <dd><code class="handover">{{ new_password.password }}</code></dd>
            </dl>
        </section>
    {% endif %}

    <section class="card card--flush">
        <table class="table">
            <thead>
            <tr>
                <th {{ sort_aria('name') }}>{{ sort_link('name', 'Name'|t) }}</th>
                <th {{ sort_aria('email') }}>{{ sort_link('email', 'Signs in with'|t) }}</th>
                <th {{ sort_aria('role') }}>{{ sort_link('role', 'Role'|t) }}</th>
                <th class="table__number" {{ sort_aria('open') }}>{{ sort_link('open', 'Open'|t) }}</th>
                <th class="table__number" {{ sort_aria('logged') }}>{{ sort_link('logged', 'Logged, 30 days'|t) }}</th>
                <th {{ sort_aria('last_seen') }}>{{ sort_link('last_seen', 'Last seen'|t) }}</th>
                <th></th>
            </tr>
            </thead>
            <tbody>
            {% for person in people %}
                <tr class="{{ person.is_active ? '' : 'row--muted' }}">
                    <td>
                        {{ ui.person(person.name, person.id) }}
                        {% if not person.is_active %}<span class="badge badge--muted">{{ 'Deactivated'|t }}</span>{% endif %}
                        {% if person.id == current_user.id %}<span class="badge">{{ 'You'|t }}</span>{% endif %}
                        {% if person.totp_enabled_at|default(null) %}<span class="badge badge--green" title="{{ 'Two-step sign-in is on'|t }}">2FA</span>{% endif %}
                    </td>
                    <td>{{ person.email }}</td>
                    <td>{{ {admin: 'Administrator', guest: 'Guest'}[person.role]|default('Member')|t }}</td>
                    <td class="table__number">{{ person.open_tickets > 0 ? person.open_tickets : '—' }}</td>
                    <td class="table__number">{{ person.minutes_30d > 0 ? person.minutes_30d|duration : '—' }}</td>
                    <td>{{ person.last_login_at ? person.last_login_at|day : 'Never'|t }}</td>
                    <td class="table__number">
                        <a href="{{ url('/people/' ~ person.id ~ '/edit') }}">{{ 'Edit'|t }}</a>
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </section>
{% endblock %}
