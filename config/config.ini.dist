; Copy this file to config/config.ini and fill it in. The real file is never
; committed: it holds the database password.

[database]
host = 127.0.0.1
port = 3306
name = cantotrack
user = root
password =
charset = utf8mb4
; The same collation as the schema. Without it the bound string parameters get
; a different collation from the string columns, and MariaDB answers any
; expression that mixes the two with "Illegal mix of collations".
collation = utf8mb4_unicode_ci

[app]
name = "CantoTrack"
env = dev
; `debug` is not only about error messages: with it switched off the Twig cache
; is used (var/cache/twig), so on a live server that folder MUST be writable or
; every page answers 500. On a development machine this never comes up, because
; there the cache is off.
debug = 1
base_url = "http://localhost/cantotrack/web"
timezone = "Europe/Budapest"

[session]
name = cantotrack_session
; Lifetime in seconds, from the last click. A year: signing in again every
; morning is a chore nobody thanks a tracker for. A lost laptop is taken care
; of by "Sign out everywhere else" on the profile, and by a new password.
; Browsers keep a cookie 400 days at most.
lifetime = 31536000

[work]
; The hours a full working day is taken to be. The timesheet compares what was
; logged against this, and colours the day accordingly.
hours_per_day = 8
; The smallest slice of time that can be logged, in minutes. Anything shorter
; is stored as this, and the person is told so, because a worklog of eleven
; seconds is noise rather than data.
minimum_minutes = 15

[mail]
; Where email goes: notifications, and the link for a lost password.
;   mail   PHP's own mail(), through the machine's sendmail
;   smtp   a mail server: the host, port, username, password and encryption below
;   file   written to var/mail as .eml files, for development
;   none   no email at all
transport = none
host =
port = 587
username =
password =
; tls (STARTTLS, the usual on 587), ssl (from the start, on 465), or none
encryption = tls
from = "cantotrack@example.com"
from_name = "CantoTrack"

[notifications]
; A notification by email waits this many minutes for whatever else happens
; to the same ticket, and goes with it in one message. 0: at once (still
; through the outbox, so within the minute).
batch_minutes = 2

[uploads]
; The largest file that can be attached, in megabytes. PHP's own limit
; (upload_max_filesize, set in web/.htaccess) has to be at least this.
max_mb = 10

[webhooks]
; Webhooks may only be sent to public addresses: an address typed into a
; form is one the server visits from inside its own network. On a development
; machine that sends to itself, allow the private ones.
allow_private = false

[recaptcha]
; Google reCAPTCHA v3 on the sign-in and lost-password forms: invisible, a
; score per submission, and anything under min_score refused. Off while
; either key is empty. Keys from https://www.google.com/recaptcha/admin (v3),
; with the site's domain on them — never commit them.
site_key =
secret_key =
min_score = 0.5

; Behind a CDN or a reverse proxy, the address a visitor really comes from is
; in a header — believed only from the proxies listed here. For Cloudflare:
; its published ranges, and HTTP_CF_CONNECTING_IP. Used by the sign-in limit.
; [app]
; trusted_proxies = "173.245.48.0/20, 103.21.244.0/22, …"
; client_ip_header = "HTTP_CF_CONNECTING_IP"
