{% extends 'layout.twig' %}
{% import 'common/macros.twig' as ui %}

{% set editing = project is not null and project.id is defined %}

{% block title %}{{ editing ? 'Project settings'|t : 'New project'|t }} — {{ app_name }}{% endblock %}
{% block heading %}{{ editing ? 'Project settings'|t : 'New project'|t }}{% endblock %}

{% block content %}
    {% if error %}<p class="flash flash--danger">{{ error }}</p>{% endif %}

    {% if editing %}
        <p class="card card--narrow project-settings__links">
            <a href="{{ url('/projects/' ~ project.id ~ '/fields') }}">{{ 'Fields of its own'|t }}</a>
            <span class="muted">— {{ 'what its tickets say beyond the usual'|t }}</span>
            <br>
            <a href="{{ url('/projects/' ~ project.id ~ '/templates') }}">{{ 'Templates and repeating tickets'|t }}</a>
            <span class="muted">— {{ 'what a new ticket starts from, and what is made by itself'|t }}</span>
        </p>
    {% endif %}

    <section class="card card--narrow">
        <form method="post" action="{{ editing ? url('/projects/' ~ project.id) : url('/projects/create') }}">
            <input type="hidden" name="_token" value="{{ csrf_token }}">

            <label for="code">{{ 'Code'|t }}</label>
            {% if editing %}
                {# Not editable: it is printed on every ticket this project ever
                   had, and in everything anyone wrote about them. #}
                <input id="code" class="field" type="text" value="{{ project.code }}" disabled>
                <p class="hint">{{ 'The code cannot be changed — every ticket in the project carries it.'|t }}</p>
            {% else %}
                <input id="code" class="field" type="text" name="code" value="{{ project.code|default('') }}"
                       maxlength="10" placeholder="CT" required autofocus>
                <p class="hint">{{ '2 to 10 letters and digits. Tickets are named after it: CT-14.'|t }}</p>
            {% endif %}

            <label for="name">{{ 'Name'|t }}</label>
            <input id="name" class="field" type="text" name="name" value="{{ project.name|default('') }}"
                   maxlength="160" required>

            <label for="description">{{ 'Description'|t }}</label>
            <textarea id="description" class="field" name="description" rows="4">{{ project.description|default('') }}</textarea>

            <label for="client">{{ 'Client'|t }}</label>
            <input id="client" class="field" type="text" name="client" value="{{ project.client_name|default('') }}"
                   maxlength="120" list="known-clients" placeholder="{{ 'Nobody — an internal project'|t }}">
            <datalist id="known-clients">{% for client in clients|default([]) %}<option value="{{ client.name }}">{% endfor %}</datalist>
            <p class="hint">
                {{ 'A client is made the first time a project names one. The reports can add up the hours by client.'|t }}
                {% if is_admin and project.client_id|default(null) %}<a href="{{ url('/clients/' ~ project.client_id) }}">{{ 'Its address and contact'|t }}</a>{% endif %}
            </p>

            {# New projects bill by default; an existing one says what it says. #}
            <label class="check">
                <input type="checkbox" name="billable_default" value="1"{{ (project.billable_default ?? 1) ? ' checked' : '' }}>
                {{ 'Hours logged here are billable, unless the entry says otherwise'|t }}
            </label>

            {% if editing and is_admin %}
                <fieldset class="choice">
                    <legend>{{ 'Who sees it'|t }}</legend>
                    <label class="check">
                        <input type="radio" name="visibility" value="team"{{ project.visibility|default('team') == 'team' ? ' checked' : '' }}>
                        {{ 'The team — every member, and the guests added below'|t }}
                    </label>
                    <label class="check">
                        <input type="radio" name="visibility" value="private"{{ project.visibility|default('') == 'private' ? ' checked' : '' }}>
                        {{ 'Private — only the people added below, and the administrators'|t }}
                    </label>
                </fieldset>

                {# What an hour here is worth, and how many the project has. #}
                <fieldset class="choice" id="budget">
                    <legend>{{ 'Rate and budget'|t }}</legend>
                    <input type="hidden" name="budget_shown" value="1">
                    <div class="form__row">
                        <div>
                            <label for="hourly_rate">{{ 'Hourly rate here ({currency})'|t({currency: currency_code()}) }}</label>
                            <input id="hourly_rate" class="field" type="text" inputmode="decimal" name="hourly_rate"
                                   value="{{ project.hourly_rate is not null ? project.hourly_rate + 0 : '' }}" placeholder="{{ 'Each person’s own'|t }}">
                        </div>
                        <div>
                            <label for="budget_alert">{{ 'Warn at (%)'|t }}</label>
                            <input id="budget_alert" class="field" type="number" min="1" max="100" name="budget_alert" value="{{ project.budget_alert|default(80) }}">
                        </div>
                    </div>
                    <div class="form__row">
                        <div>
                            <label for="budget_hours">{{ 'Budget in hours'|t }}</label>
                            <input id="budget_hours" class="field" type="text" inputmode="decimal" name="budget_hours"
                                   value="{{ project.budget_hours is not null ? project.budget_hours + 0 : '' }}" placeholder="{{ 'None'|t }}">
                        </div>
                        <div>
                            <label for="budget_amount">{{ 'Budget in money ({currency})'|t({currency: currency_code()}) }}</label>
                            <input id="budget_amount" class="field" type="text" inputmode="decimal" name="budget_amount"
                                   value="{{ project.budget_amount is not null ? project.budget_amount + 0 : '' }}" placeholder="{{ 'None'|t }}">
                        </div>
                    </div>
                    <p class="hint">{{ 'The project’s rate counts instead of each person’s. Every hour logged counts against the hours; the billable ones, at their rate, against the money.'|t }}</p>
                </fieldset>
            {% endif %}

            {% if editing %}

                {# What a card on the board shows — fewer, on a board that
                   has a lot of them. #}
                <fieldset class="choice card-fields">
                    <legend>{{ 'On the board’s cards'|t }}</legend>
                    <input type="hidden" name="card_fields_shown" value="1">
                    {% set shown = project.card_fields ? project.card_fields|split(',') : ['priority', 'epic', 'labels', 'family', 'assignee', 'due', 'points', 'logged'] %}
                    {% for field, label in {
                        priority: 'Priority', epic: 'Epic', labels: 'Labels', family: 'Parent and subtasks',
                        assignee: 'Assignee', due: 'Due date', points: 'Story points', logged: 'Hours logged'
                    } %}
                        <label class="check">
                            <input type="checkbox" name="card_fields[]" value="{{ field }}"{{ field in shown ? ' checked' : '' }}>
                            {{ label|t }}
                        </label>
                    {% endfor %}
                </fieldset>

                <label class="check">
                    <input type="checkbox" name="is_archived" value="1"{{ project.is_archived ? ' checked' : '' }}>
                    {{ 'Archived — hidden from the lists, and takes no new tickets'|t }}
                </label>
            {% endif %}

            <div class="form__actions">
                <button class="button button--primary" type="submit">{{ editing ? 'Save'|t : 'Create project'|t }}</button>
                <a class="button" href="{{ editing ? url('/projects/' ~ project.id) : url('/projects') }}">{{ 'Cancel'|t }}</a>
            </div>
        </form>
    </section>

    {% if editing %}
        <section class="card card--narrow" id="members">
            <h2 class="card__title">{{ 'Members'|t }}</h2>
            <p class="card__body">
                {{ project.visibility == 'private'
                    ? 'Only these people, and the administrators, can see the project.'|t
                    : 'Every member of the team sees this project. Add guests here — somebody from the client, say — to let them read and comment on it.'|t }}
                {{ 'A lead runs the project’s settings — its columns, members and fields — without being an administrator.'|t }}
            </p>
            {% if members is not empty %}
                <ul class="split-list">
                    {% for member in members %}
                        <li>
                            <span>{{ member.name }}{% if member.role == 'guest' %} <span class="badge badge--amber">{{ 'Guest'|t }}</span>{% endif %}{% if member.project_role == 'lead' %} <span class="badge badge--blue">{{ 'Lead'|t }}</span>{% endif %}{% if not member.is_active %} <span class="badge badge--muted">{{ 'Deactivated'|t }}</span>{% endif %}</span>
                            <span class="muted">{{ member.email }}</span>
                            {% if member.role != 'guest' %}
                                <form class="move" method="post" action="{{ url('/projects/' ~ project.id ~ '/members/' ~ member.id ~ '/role') }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token }}">
                                    <select class="field field--inline" name="role" data-autosubmit aria-label="{{ 'Role of {name}'|t({name: member.name}) }}">
                                        <option value="member"{{ member.project_role != 'lead' ? ' selected' : '' }}>{{ 'Member'|t }}</option>
                                        <option value="lead"{{ member.project_role == 'lead' ? ' selected' : '' }}>{{ 'Lead — runs its settings'|t }}</option>
                                    </select>
                                    <button class="button button--small autosubmit__button" type="submit">{{ 'Save'|t }}</button>
                                </form>
                            {% endif %}
                            <form method="post" action="{{ url('/projects/' ~ project.id ~ '/members/' ~ member.id ~ '/delete') }}">
                                <input type="hidden" name="_token" value="{{ csrf_token }}">
                                <button class="link-button" type="submit" aria-label="{{ 'Take {name} off the project'|t({name: member.name}) }}">×</button>
                            </form>
                        </li>
                    {% endfor %}
                </ul>
            {% endif %}
            {% set member_ids = members|column('id') %}
            {% set addable = people|filter(p => p.id not in member_ids and p.role != 'admin') %}
            {% if addable is not empty %}
                <form class="form__row form__row--inline" method="post" action="{{ url('/projects/' ~ project.id ~ '/members') }}">
                    <input type="hidden" name="_token" value="{{ csrf_token }}">
                    <select class="field" name="user_id" aria-label="{{ 'Person'|t }}">
                        {% for person in addable %}
                            <option value="{{ person.id }}">{{ person.name }}{% if person.role == 'guest' %} ({{ 'guest'|t }}){% endif %}</option>
                        {% endfor %}
                    </select>
                    <button class="button" type="submit">{{ 'Add'|t }}</button>
                </form>
            {% endif %}
        </section>

        {#
            The columns. Each is a small form of its own, so changing one never
            submits the others; the order is changed a step at a time, which
            works on a keyboard and a phone as well as with a mouse.
        #}
        <section class="card" id="workflow">
            <h2 class="card__title">{{ 'Columns'|t }}</h2>
            <p class="card__body">
                {{ 'The board’s columns, left to right. Each belongs to a kind: tickets in a done column count as finished, everything else as open.'|t }}
            </p>

            <div class="workflow">
                {% for status in statuses %}
                    <div class="workflow__row">
                        <form class="workflow__form" method="post" action="{{ url('/statuses/' ~ status.id) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token }}">
                            <span class="workflow__preview">{{ ui.status(status.name, status.colour) }}</span>
                            <input class="field field--inline" type="text" name="name" value="{{ status.name }}"
                                   maxlength="60" required aria-label="{{ 'Name'|t }}">
                            <select class="field field--inline" name="category" aria-label="{{ 'Kind'|t }}">
                                {% for category in ['todo', 'in_progress', 'done'] %}
                                    <option value="{{ category }}"{{ status.category == category ? ' selected' : '' }}>{{ ui.category_label(category) }}</option>
                                {% endfor %}
                            </select>
                            <select class="field field--inline" name="colour" aria-label="{{ 'Colour'|t }}">
                                {% for colour, label in {slate: 'Grey', blue: 'Blue', amber: 'Amber', green: 'Green', violet: 'Violet', red: 'Red'} %}
                                    <option value="{{ colour }}"{{ status.colour == colour ? ' selected' : '' }}>{{ label|t }}</option>
                                {% endfor %}
                            </select>
                            <input class="field field--inline workflow__wip" type="number" name="wip_limit" min="1" max="999"
                                   value="{{ status.wip_limit }}" placeholder="{{ 'No limit'|t }}" aria-label="{{ 'Limit'|t }}">
                            <button class="button button--small" type="submit">{{ 'Save'|t }}</button>
                        </form>

                        <form class="workflow__move" method="post" action="{{ url('/statuses/' ~ status.id ~ '/move') }}">
                            <input type="hidden" name="_token" value="{{ csrf_token }}">
                            <button class="button button--small" type="submit" name="direction" value="left"
                                    {{ loop.first ? 'disabled' : '' }} aria-label="{{ 'Move left'|t }}">←</button>
                            <button class="button button--small" type="submit" name="direction" value="right"
                                    {{ loop.last ? 'disabled' : '' }} aria-label="{{ 'Move right'|t }}">→</button>
                        </form>

                        <details class="workflow__delete">
                            <summary class="link-button link-button--text">{{ 'Delete'|t }}</summary>
                            <form method="post" action="{{ url('/statuses/' ~ status.id ~ '/delete') }}"
                                  data-confirm="{{ 'Delete the column {name}?'|t({name: status.name|t}) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token }}">
                                {% if status.ticket_count > 0 %}
                                    <label for="move-{{ status.id }}">
                                        {{ plural('Its {count} ticket goes to', 'Its {count} tickets go to', status.ticket_count) }}
                                    </label>
                                    <select id="move-{{ status.id }}" class="field field--inline" name="move_to" required>
                                        {% for other in statuses|filter(other => other.id != status.id) %}
                                            <option value="{{ other.id }}">{{ other.name|t }}</option>
                                        {% endfor %}
                                    </select>
                                {% endif %}
                                <button class="button button--small button--danger" type="submit">{{ 'Delete column'|t }}</button>
                            </form>
                        </details>
                    </div>
                {% endfor %}
            </div>

            <form class="workflow__add" method="post" action="{{ url('/projects/' ~ project.id ~ '/statuses') }}">
                <input type="hidden" name="_token" value="{{ csrf_token }}">
                <input class="field field--inline" type="text" name="name" maxlength="60" required
                       placeholder="{{ 'New column'|t }}" aria-label="{{ 'New column'|t }}">
                <select class="field field--inline" name="category" aria-label="{{ 'Kind'|t }}">
                    {% for category in ['todo', 'in_progress', 'done'] %}
                        <option value="{{ category }}"{{ category == 'in_progress' ? ' selected' : '' }}>{{ ui.category_label(category) }}</option>
                    {% endfor %}
                </select>
                <select class="field field--inline" name="colour" aria-label="{{ 'Colour'|t }}">
                    {% for colour, label in {slate: 'Grey', blue: 'Blue', amber: 'Amber', green: 'Green', violet: 'Violet', red: 'Red'} %}
                        <option value="{{ colour }}">{{ label|t }}</option>
                    {% endfor %}
                </select>
                <button class="button" type="submit">{{ 'Add column'|t }}</button>
            </form>
        </section>

        {#
            Which column a ticket may go to from which. Every box ticked is
            the way it always was: anything goes. A row with boxes cleared
            limits that column — its tickets go only where it is ticked.
        #}
        <section class="card" id="moves">
            <h2 class="card__title">{{ 'Moves between columns'|t }}</h2>
            <p class="card__body">
                {{ 'Where a ticket in each column may go next. Untick a box to rule that move out — say, from In progress straight to Done without a review. Rules and commits that close tickets are not held to it.'|t }}
            </p>
            <form method="post" action="{{ url('/projects/' ~ project.id ~ '/moves') }}">
                <input type="hidden" name="_token" value="{{ csrf_token }}">
                <div class="moves">
                    <table class="table moves__table">
                        <thead>
                            <tr>
                                <th scope="col">{{ 'From ↓ · to →'|t }}</th>
                                {% for to in statuses %}<th scope="col">{{ ui.status(to.name, to.colour) }}</th>{% endfor %}
                            </tr>
                        </thead>
                        <tbody>
                            {% for from in statuses %}
                                <tr>
                                    <th scope="row">{{ ui.status(from.name, from.colour) }}</th>
                                    {% for to in statuses %}
                                        <td>
                                            {% if to.id == from.id %}
                                                <span class="muted" aria-hidden="true">·</span>
                                            {% else %}
                                                <input type="checkbox" name="moves[{{ from.id }}][]" value="{{ to.id }}"
                                                       {{ from.moves is null or to.id in from.moves ? 'checked' : '' }}
                                                       aria-label="{{ 'From {from} to {to}'|t({from: from.name|t, to: to.name|t}) }}">
                                            {% endif %}
                                        </td>
                                    {% endfor %}
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
                <div class="form__actions">
                    <button class="button button--primary" type="submit">{{ 'Save the moves'|t }}</button>
                    <button class="button" type="submit" name="reset" value="1">{{ 'Allow every move'|t }}</button>
                </div>
            </form>
        </section>

        {% if is_admin %}
        <section class="card card--narrow">
            <h2 class="card__title">{{ 'Delete this project'|t }}</h2>
            <p class="card__body">
                {{ 'This removes the project, its epics and its tickets. A project with hours logged in it cannot be deleted — archive it instead, which keeps all of that and takes it out of the way.'|t }}
            </p>
            <form method="post" action="{{ url('/projects/' ~ project.id ~ '/delete') }}"
                  data-confirm="{{ 'Delete {code} and everything in it?'|t({code: project.code}) }}">
                <input type="hidden" name="_token" value="{{ csrf_token }}">
                <button class="button button--danger" type="submit">{{ 'Delete {code}'|t({code: project.code}) }}</button>
            </form>
        </section>
        {% endif %}
    {% endif %}
{% endblock %}
