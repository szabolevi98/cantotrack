RewriteEngine On

# The API's bearer token. Under FastCGI, Apache keeps the Authorization header
# to itself unless it is handed on like this.
RewriteCond %{HTTP:Authorization} .
RewriteRule ^ - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# A real file or folder is served as it is; everything else goes to the front
# controller.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

RewriteRule ^ index.php [L]

# PHP's own start-up warnings must not reach the response either.
#
# These happen BEFORE the script runs, so the ini_set() in index.php cannot
# catch them. The `<IfModule>` is needed because `php_flag` only means anything
# under mod_php; under FastCGI the same settings come from a .user.ini.
#
# The upload limits are here too: a screenshot is routinely over PHP's default
# of 2 MB, and the application's own limit (uploads.max_mb, 10 MB) can only
# apply to what PHP let through first.
<IfModule mod_php.c>
    php_flag display_startup_errors off
    php_flag display_errors off
    php_value upload_max_filesize 12M
    php_value post_max_size 40M
    php_value max_file_uploads 20
</IfModule>
<IfModule mod_php8.c>
    php_flag display_startup_errors off
    php_flag display_errors off
    php_value upload_max_filesize 12M
    php_value post_max_size 40M
    php_value max_file_uploads 20
</IfModule>
