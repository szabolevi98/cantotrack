{% extends 'layout.twig' %}

{% block title %}{{ account.name }} — {{ 'Service accounts'|t }} — {{ app_name }}{% endblock %}
{% block heading %}<i class="bi bi-robot" aria-hidden="true"></i> {{ account.name }}{% endblock %}
{% block subheading %}<p class="content__sub"><a href="{{ url('/settings/service-accounts') }}">← {{ 'Service accounts'|t }}</a> · <code>@{{ account.handle }}</code></p>{% endblock %}

{% block content %}
    {% if new_token %}
        <section class="card card--narrow new-secret" role="status">
            <h2 class="card__title">{{ 'The new token'|t }}</h2>
            <p class="card__body">{{ 'Copy it now into whatever uses it. It is not stored in readable form, so this page cannot show it again.'|t }}</p>
            <input class="field field--code" type="text" value="{{ new_token }}" readonly aria-label="{{ 'Token'|t }}" data-select-on-focus>
            <pre class="code-sample"><code>curl -H "Authorization: Bearer {{ new_token }}" {{ api_base }}/me</code></pre>
        </section>
    {% endif %}

    {% if not account.is_active %}
        <section class="card card--narrow" role="status">
            <p class="card__body">{{ 'It is switched off: its tokens are refused until it is switched on again.'|t }}</p>
        </section>
    {% endif %}

    <section class="card card--flush">
        <header class="card__head"><h2 class="card__title">{{ 'Its tokens'|t }}</h2></header>
        {% if tokens is empty %}
            <p class="card__empty">{{ 'No tokens yet.'|t }}</p>
        {% else %}
            <table class="table">
                <thead><tr>
                    <th>{{ 'Name'|t }}</th><th>{{ 'Starts with'|t }}</th><th>{{ 'Made'|t }}</th>
                    <th>{{ 'Last used'|t }}</th><th>{{ 'Expires'|t }}</th><th></th>
                </tr></thead>
                <tbody>
                {% for token in tokens %}
                    {% set expired = token.expires_on and token.expires_on < 'now'|date('Y-m-d') %}
                    <tr>
                        <td>{{ token.name }}{% if expired %} <span class="badge badge--muted">{{ 'Expired'|t }}</span>{% endif %}</td>
                        <td><code>{{ token.prefix }}…</code></td>
                        <td>{{ token.created_at|day }}</td>
                        <td>{{ token.last_used_at ? token.last_used_at|day : 'Never'|t }}</td>
                        <td>{{ token.expires_on ? token.expires_on|day : 'Never'|t }}</td>
                        <td class="table__number">
                            <form method="post" action="{{ url('/settings/service-accounts/' ~ account.id ~ '/tokens/' ~ token.id ~ '/delete') }}"
                                  data-confirm="{{ 'Revoke “{name}”? Whatever uses it stops working.'|t({name: token.name}) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token }}">
                                <button class="button button--small button--danger" type="submit">{{ 'Revoke'|t }}</button>
                            </form>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        {% endif %}
    </section>

    <div class="split split--even">
        <section class="card">
            <h2 class="card__title">{{ 'Make a token'|t }}</h2>
            <form method="post" action="{{ url('/settings/service-accounts/' ~ account.id ~ '/tokens') }}">
                <input type="hidden" name="_token" value="{{ csrf_token }}">
                <div class="form__row">
                    <div>
                        <label for="token_name">{{ 'Where it goes'|t }}</label>
                        <input id="token_name" class="field" type="text" name="name" maxlength="80" required placeholder="{{ 'Production'|t }}">
                    </div>
                    <div>
                        <label for="expires_on">{{ 'Expires'|t }}</label>
                        <input id="expires_on" class="field" type="date" name="expires_on" min="{{ 'tomorrow'|date('Y-m-d') }}">
                    </div>
                </div>
                <p class="hint">{{ 'Leave the date empty for a token that lasts until it is revoked. One token per place it is kept makes a leak one token to revoke.'|t }}</p>
                <div class="form__actions">
                    <button class="button button--primary" type="submit">{{ 'Make the token'|t }}</button>
                </div>
            </form>
        </section>

        <section class="card">
            <h2 class="card__title">{{ 'The account'|t }}</h2>
            <form method="post" action="{{ url('/settings/service-accounts/' ~ account.id) }}">
                <input type="hidden" name="_token" value="{{ csrf_token }}">
                <label for="account_name">{{ 'What uses it'|t }}</label>
                <input id="account_name" class="field" type="text" name="name" maxlength="120" required value="{{ account.name }}">
                <label for="account_role">{{ 'May'|t }}</label>
                <select id="account_role" class="field" name="role">
                    <option value="member"{{ account.role != 'guest' ? ' selected' : '' }}>{{ 'Change the work, like a member'|t }}</option>
                    <option value="guest"{{ account.role == 'guest' ? ' selected' : '' }}>{{ 'Only read and comment, on the projects it is added to'|t }}</option>
                </select>
                <label class="check"><input type="checkbox" name="is_active" value="1"{{ account.is_active ? ' checked' : '' }}> {{ 'Switched on'|t }}</label>
                <div class="form__actions">
                    <button class="button button--primary" type="submit">{{ 'Save'|t }}</button>
                </div>
            </form>

            <h3 class="card__subtitle">{{ 'Projects it was added to'|t }}</h3>
            {% if projects is empty %}
                <p class="hint">{{ account.role == 'guest'
                    ? 'None yet, so it sees nothing. Add it to a project under the project’s settings → Members, like a person.'|t
                    : 'None: it sees the team’s projects. Add it to a private one under the project’s settings → Members, like a person.'|t }}</p>
            {% else %}
                <ul class="split-list">
                    {% for project in projects %}
                        <li><a href="{{ url('/projects/' ~ project.id ~ '/edit#members') }}"><strong>{{ project.code }}</strong> {{ project.name }}</a>{% if project.visibility == 'private' %} <span class="badge badge--muted">{{ 'Private'|t }}</span>{% endif %}</li>
                    {% endfor %}
                </ul>
            {% endif %}
        </section>
    </div>
{% endblock %}
