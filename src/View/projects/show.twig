{% extends 'layout.twig' %}
{% import 'common/macros.twig' as ui %}
{% set search_project = {id: project.id, code: project.code} %}

{% block title %}{{ project.code }} — {{ app_name }}{% endblock %}
{% block heading %}{{ project.name }}{% endblock %}

{% block subheading %}
    <p class="content__sub">
        <span class="project__code">{{ project.code }}</span>
        {% if project.is_archived %}<span class="badge badge--muted">{{ 'Archived'|t }}</span>{% endif %}
        {% if project.visibility == 'private' %}<span class="badge badge--violet">{{ 'Private'|t }}</span>{% endif %}
        {% if project.description %}{{ project.description }}{% endif %}
    </p>
{% endblock %}

{% block actions %}
    <a class="button" href="{{ url('/projects/' ~ project.id ~ '/epics/create') }}">{{ 'New epic'|t }}</a>
    {% if can_work %}
        <a class="button" href="{{ url('/projects/' ~ project.id ~ '/import') }}">{{ 'Import'|t }}</a>
        <a class="button button--primary" href="{{ url('/tickets/create?project=' ~ project.id) }}">{{ 'New ticket'|t }}</a>
    {% endif %}
    {% if can_lead|default(is_admin) %}
        <a class="button" href="{{ url('/projects/' ~ project.id ~ '/edit') }}">{{ 'Settings'|t }}</a>
    {% endif %}
{% endblock %}

{% block content %}
    {% include 'common/project_tabs.twig' with {project: project, active: 'board'} only %}
    {% include 'projects/budget.twig' with {budget: budget|default(null)} %}

    {% if epics is not empty %}
        <details class="card epics-card" open>
            <summary class="card__title">{{ 'Epics'|t }} <span class="muted">{{ epics|length }}</span></summary>
            <div class="epics">
                {% for epic in epics %}
                    {% set total = epic.ticket_count|default(0) %}
                    {% set done = epic.done_count|default(0) %}
                    <a class="epic{{ epic.is_done ? ' epic--done' : '' }}" href="{{ url('/epics/' ~ epic.id) }}">
                        <strong>{{ epic.title }}</strong>
                        <span class="epic__meta">
                            {{ total > 0 ? '{done} of {total} done'|t({done: done, total: total}) : 'No tickets yet'|t }}
                        </span>
                        {% if total > 0 %}
                            <span class="bar"><span class="bar__fill" style="width: {{ (done / total * 100)|round }}%"></span></span>
                        {% endif %}
                    </a>
                {% endfor %}
            </div>
        </details>
    {% endif %}

    {% if active_sprint %}
        {# The running sprint, which the board shows unless asked for
           everything: what it is for, how long it has left, how far it got. #}
        {% set progress = sprint_progress %}
        <section class="card sprint-bar">
            <div class="sprint-bar__what">
                <strong>{{ active_sprint.name }}</strong>
                {% if active_sprint.ends_on %}
                    {% set left = ((active_sprint.ends_on|date('U') - 'today'|date('U')) / 86400)|round %}
                    <span class="muted">{{ left >= 0 ? plural('{count} day left', '{count} days left', left) : 'Ended {day}'|t({day: active_sprint.ends_on|day}) }}</span>
                {% endif %}
                {% if active_sprint.goal %}<span class="sprint-bar__goal">{{ active_sprint.goal }}</span>{% endif %}
            </div>
            <div class="sprint-bar__progress">
                <span class="muted">{{ '{done} of {total} done'|t({done: progress.done, total: progress.total}) }}{% if progress.points > 0 %} · {{ '{done} of {total} points'|t({done: progress.done_points, total: progress.points}) }}{% endif %}</span>
                <span class="bar"><span class="bar__fill" style="width: {{ progress.total > 0 ? (progress.done / progress.total * 100)|round : 0 }}%"></span></span>
            </div>
            <nav class="segmented" aria-label="{{ 'Show'|t }}">
                <a class="segmented__item{{ scope == 'sprint' ? ' is-active' : '' }}" href="{{ url('/projects/' ~ project.id) }}">{{ 'This sprint'|t }}</a>
                <a class="segmented__item{{ scope == 'all' ? ' is-active' : '' }}" href="{{ url('/projects/' ~ project.id ~ '?scope=all') }}">{{ 'Everything'|t }}</a>
            </nav>
            <a class="button button--small" href="{{ url('/sprints/' ~ active_sprint.id) }}">{{ 'Burndown'|t }}</a>
        </section>
    {% endif %}

    {% if shared_sprints is not empty %}
        {# Sprints of the shared boards this project is on: planned and run
           there, with the other projects' work. #}
        <p class="card sprint-bar sprint-bar--shared">
            {% for shared in shared_sprints %}
                <span>
                    {{ 'Running on {board}:'|t({board: shared.board_name}) }}
                    <a href="{{ url('/boards/' ~ shared.board_id) }}"><strong>{{ shared.name }}</strong></a>
                    {% if shared.ends_on %}<span class="muted">· {{ shared.ends_on|day }}</span>{% endif %}
                </span>
            {% endfor %}
        </p>
    {% endif %}

    {#
        The board's filters and how it is split, in the address like the
        ticket list's. They narrow what is drawn; the columns and their
        counts stay the project's.
    #}
    <form class="filters card board-filters" method="get" action="{{ url('/projects/' ~ project.id) }}">
        {% if scope == 'all' and active_sprint %}<input type="hidden" name="scope" value="all">{% endif %}
        <input class="field field--inline filters__search" type="search" name="q" value="{{ filters.q }}"
               placeholder="{{ 'Filter the cards'|t }}" aria-label="{{ 'Filter the cards'|t }}">

        <select class="field field--inline" name="who" data-autosubmit aria-label="{{ 'Whose'|t }}">
            <option value="">{{ 'Everybody’s'|t }}</option>
            <option value="me"{{ who == 'me' ? ' selected' : '' }}>{{ 'Only mine'|t }}</option>
            <option value="none"{{ who == 'none' ? ' selected' : '' }}>{{ 'Unassigned'|t }}</option>
            {% for person in people %}
                <option value="{{ person.id }}"{{ who == person.id ~ '' ? ' selected' : '' }}>{{ person.name }}</option>
            {% endfor %}
        </select>

        {% if epics is not empty %}
            <select class="field field--inline" name="epic" data-autosubmit aria-label="{{ 'Epic'|t }}">
                <option value="">{{ 'Every epic'|t }}</option>
                <option value="none"{{ epic == 'none' ? ' selected' : '' }}>{{ 'No epic'|t }}</option>
                {% for one in epics %}
                    <option value="{{ one.id }}"{{ epic == one.id ~ '' ? ' selected' : '' }}>{{ one.title }}</option>
                {% endfor %}
            </select>
        {% endif %}

        <select class="field field--inline" name="type" data-autosubmit aria-label="{{ 'Type'|t }}">
            <option value="">{{ 'Any type'|t }}</option>
            {% for value in types %}
                <option value="{{ value }}"{{ filters.type == value ? ' selected' : '' }}>{{ ui.type_label(value) }}</option>
            {% endfor %}
        </select>

        {% if labels is not empty %}
            <select class="field field--inline" name="label" data-autosubmit aria-label="{{ 'Label'|t }}">
                <option value="">{{ 'Any label'|t }}</option>
                {% for label in labels %}
                    <option value="{{ label.name }}"{{ filters.label == label.name ? ' selected' : '' }}>{{ label.name }}</option>
                {% endfor %}
            </select>
        {% endif %}

        <select class="field field--inline" name="lanes" data-autosubmit aria-label="{{ 'Swimlanes'|t }}">
            <option value="">{{ 'No swimlanes'|t }}</option>
            <option value="assignee"{{ lanes_by == 'assignee' ? ' selected' : '' }}>{{ 'A lane per person'|t }}</option>
            <option value="epic"{{ lanes_by == 'epic' ? ' selected' : '' }}>{{ 'A lane per epic'|t }}</option>
        </select>

        <button class="button autosubmit__button" type="submit">{{ 'Filter'|t }}</button>
        {% if narrowed or lanes_by != 'none' %}
            <a class="button" href="{{ url('/projects/' ~ project.id) }}">{{ 'Clear'|t }}</a>
        {% endif %}
    </form>

    {#
        The board. A card can be dragged — between columns, up and down within
        one, and across lanes, which gives it that lane's person or epic. The
        select on every card does the same without a mouse, on a phone, or
        without a line of JavaScript.
    #}
    {% set shows = project.card_fields ? project.card_fields|split(',') : ['priority', 'epic', 'labels', 'family', 'assignee', 'due', 'points', 'logged'] %}
    <div class="board" style="--columns: {{ statuses|length }}"
         data-move-url="{{ url('/tickets/{id}/move') }}" data-move-failed="{{ 'The move did not go through.'|t }}" data-board>
        <div class="board__row board__row--heads">
            {% for status in statuses %}
                {% set shown = counts[status.id]|default(status.ticket_count) %}
                {% set over = status.wip_limit and status.ticket_count > status.wip_limit %}
                <header class="board__head{{ over ? ' board__head--over' : '' }}" data-head-for="{{ status.id }}">
                    {{ ui.status(status.name, status.colour) }}
                    {# A limit is shown as "3 / 4", and over it the column says so
                       — it does not refuse the ticket. #}
                    <span class="board__count"{{ over ? ' title="' ~ ('Over the limit of {count}'|t({count: status.wip_limit})) ~ '"' : '' }}>
                        <span data-count{% if shown != status.ticket_count %} title="{{ '{count} in the whole project'|t({count: status.ticket_count}) }}"{% endif %}>{{ shown }}</span>{% if status.wip_limit %} / <span data-limit>{{ status.wip_limit }}</span>{% endif %}
                    </span>
                </header>
            {% endfor %}
        </div>

        {% for lane in lanes %}
            {% if lane.title %}
                <h3 class="board__lane-title">
                    {% if lanes_by == 'assignee' and lane.value %}{{ ui.person(lane.title, lane.value) }}{% else %}{{ lane.title }}{% endif %}
                </h3>
            {% endif %}

            <div class="board__row" data-lane-field="{{ lane.field }}" data-lane-value="{{ lane.value }}">
                {% for status in statuses %}
                    <section class="board__column" data-status-id="{{ status.id }}"
                             {% if status.moves is not null %}data-moves="{{ status.moves|join(',') }}"{% endif %}
                             aria-label="{{ status.name|t }}{{ lane.title ? ' — ' ~ lane.title : '' }}">
                        {% for ticket in lane.columns[status.id]|default([]) %}
                            {% include 'common/ticket_card.twig' with {ticket: ticket, shows: shows, lanes_by: lanes_by, can_work: can_work, statuses: statuses, back: '/projects/' ~ project.id} only %}
                        {% endfor %}

                        {% if loop.parent.loop.last and more[status.id]|default(0) > 0 and not narrowed and scope != 'sprint' %}
                            {# A done column only ever grows, so it shows the latest
                               and says how many more there are rather than drawing
                               two years of finished work on every visit. #}
                            <a class="board__more" href="{{ url('/tickets?project=' ~ project.id ~ '&status=' ~ status.id) }}">
                                {{ plural('and {count} more', 'and {count} more', more[status.id]) }}
                            </a>
                        {% endif %}
                    </section>
                {% endfor %}
            </div>
        {% else %}
            <p class="card card__empty">{{ 'No cards match these filters.'|t }}</p>
        {% endfor %}
    </div>
{% endblock %}
