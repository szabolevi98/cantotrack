{# The statements as a list — the administrators' and a client's guest's. #}
{% if statements is empty %}
    <p class="card__empty">{{ 'No statements yet.'|t }}</p>
{% else %}
    <table class="table">
        <thead>
        <tr>
            <th>{{ 'Number'|t }}</th>
            <th>{{ 'Client'|t }}</th>
            <th>{{ 'Period'|t }}</th>
            <th class="table__number">{{ 'Hours'|t }}</th>
            <th class="table__number">{{ 'Amount'|t }}</th>
            <th>{{ 'Issued'|t }}</th>
        </tr>
        </thead>
        <tbody>
        {% for s in statements %}
            <tr>
                <td>
                    <a href="{{ url('/billing/statements/' ~ s.id) }}">{{ s.number ?: 'Draft'|t }}</a>
                    {% if s.state == 'draft' %}<span class="badge">{{ 'Draft'|t }}</span>{% endif %}
                </td>
                <td>{% if is_admin %}<a href="{{ url('/clients/' ~ s.client_id) }}">{{ s.client }}</a>{% else %}{{ s.client }}{% endif %}</td>
                <td>{{ s.period_from|day }} — {{ s.period_to|day }}</td>
                <td class="table__number">{{ (s.total_minutes ?: 0)|hours }}</td>
                <td class="table__number">{{ (s.total_amount ?: 0)|money(s.currency) }}</td>
                <td>{{ s.issued_at ? s.issued_at|day : '—' }}</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
{% endif %}
