{% extends 'layout.twig' %}
{% import 'common/macros.twig' as ui %}

{% set key = ticket.project_code ~ '-' ~ ticket.number %}
{% set search_project = {id: ticket.project_id, code: ticket.project_code} %}
{% set finished = ticket.status_category == 'done' %}

{% block title %}{{ key }} {{ ticket.title }} — {{ app_name }}{% endblock %}
{% block heading %}
    {{- ticket.title -}}
    {% if can_work %}
        <button class="inline__pencil inline__pencil--title" type="button" data-inline-open data-inline-for="title-form"
                aria-label="{{ 'Change the {field}'|t({field: 'title'|t}) }}" title="{{ 'Change the {field}'|t({field: 'title'|t}) }}">
            <i class="bi bi-pencil" aria-hidden="true"></i>
        </button>
    {% endif %}
{% endblock %}

{% block subheading %}
    {% if can_work %}
        <form class="inline__form inline__form--title" id="title-form" method="post" action="{{ url('/tickets/' ~ ticket.id ~ '/field') }}" data-inline-form hidden>
            <input type="hidden" name="_token" value="{{ csrf_token }}">
            <input type="hidden" name="field" value="title">
            <input class="field" type="text" name="value" value="{{ ticket.title }}" maxlength="250" required aria-label="{{ 'Title'|t }}">
            <p class="inline__error" data-inline-error hidden></p>
            <div class="inline__buttons">
                <button class="button button--small button--primary" type="submit">{{ 'Save'|t }}</button>
                <button class="button button--small" type="button" data-inline-cancel>{{ 'Cancel'|t }}</button>
            </div>
        </form>
    {% endif %}
    <p class="content__sub">
        {{ ui.type_icon(ticket.type) }}
        <span class="ticket-key ticket-key--plain">{{ key }}</span>
        {{ 'in'|t }} <a href="{{ url('/projects/' ~ ticket.project_id) }}">{{ ticket.project_name }}</a>
        {% if ticket.epic_title %}
            · <a href="{{ url('/epics/' ~ ticket.epic_id) }}">{{ ticket.epic_title }}</a>
        {% endif %}
        {% if ticket.parent_id %}
            · {{ 'a subtask of'|t }} <a href="{{ url('/tickets/' ~ ticket.parent_id) }}"><span class="ticket-key">{{ ticket.project_code }}-{{ ticket.parent_number }}</span> {{ ticket.parent_title }}</a>
        {% endif %}
    </p>
{% endblock %}

{% block actions %}
    {# Following: hearing about its changes and comments. The reporter and
       the assignee always do; anybody else chooses. #}
    <form method="post" action="{{ url('/tickets/' ~ ticket.id ~ '/favourite') }}">
        <input type="hidden" name="_token" value="{{ csrf_token }}">
        <button class="button button--icon{{ favourite ? ' is-on' : '' }}" type="submit" aria-pressed="{{ favourite ? 'true' : 'false' }}"
                title="{{ favourite ? 'Take the star off'|t : 'Star it: a row in your grid, first when you log time'|t }}"
                aria-label="{{ favourite ? 'Take the star off'|t : 'Star it'|t }}">
            <i class="bi {{ favourite ? 'bi-star-fill' : 'bi-star' }}" aria-hidden="true"></i>
        </button>
    </form>
    <form method="post" action="{{ url('/tickets/' ~ ticket.id ~ '/watch') }}">
        <input type="hidden" name="_token" value="{{ csrf_token }}">
        <button class="button{{ watching ? ' is-on' : '' }}" type="submit" aria-pressed="{{ watching ? 'true' : 'false' }}"
                title="{{ plural('{count} person follows this', '{count} people follow this', watchers) }}">
            {{ watching ? 'Following'|t : 'Follow'|t }}{% if watchers > 0 %} · {{ watchers }}{% endif %}
        </button>
    </form>
    {% if can_work %}
        {{ ui.move(ticket, statuses, '/tickets/' ~ ticket.id) }}
        <a class="button" href="{{ url('/tickets/create?clone=' ~ ticket.id) }}" title="{{ 'A new ticket, filled in from this one'|t }}">{{ 'Clone'|t }}</a>
        <a class="button" href="{{ url('/tickets/' ~ ticket.id ~ '/edit') }}">{{ 'Edit'|t }}</a>
    {% endif %}
{% endblock %}

{% block content %}
    <div class="split">
        <div class="split__main">
            {% include 'tickets/description.twig' %}

            {#
                The steps the ticket is broken into, each a ticket of its own:
                how many are done, and a line to add the next. A subtask has
                none of its own — one level deep.
            #}
            {% if not ticket.parent_id %}
                <section class="card" id="subtasks">
                    <header class="subtasks__head">
                        <h2 class="card__title">{{ 'Subtasks'|t }}</h2>
                        {% if subtasks is not empty %}
                            {% set done_count = subtasks|filter(s => s.status_category == 'done')|length %}
                            <span class="muted">{{ '{done} of {count} done'|t({done: done_count, count: subtasks|length}) }}</span>
                            <span class="bar subtasks__bar"><span class="bar__fill" style="width: {{ (done_count / subtasks|length * 100)|round }}%"></span></span>
                        {% endif %}
                    </header>
                    {% if subtasks is not empty %}
                        <ul class="subtasks">
                            {% for sub in subtasks %}
                                <li class="subtasks__item{{ sub.status_category == 'done' ? ' subtasks__item--done' : '' }}">
                                    {{ ui.type_icon(sub.type) }}
                                    <a class="ticket-key" href="{{ url('/tickets/' ~ sub.id) }}">{{ sub.project_code }}-{{ sub.number }}</a>
                                    <a class="subtasks__title" href="{{ url('/tickets/' ~ sub.id) }}">{{ sub.title }}</a>
                                    <span class="subtasks__meta">
                                        {% if sub.logged_minutes > 0 or sub.estimate_minutes %}
                                            <span class="muted">{{ sub.logged_minutes|duration }}{% if sub.estimate_minutes %} / {{ sub.estimate_minutes|duration }}{% endif %}</span>
                                        {% endif %}
                                        {{ ui.person(sub.assignee_name, sub.assignee_id) }}
                                        {% if can_work %}
                                            {{ ui.move(sub, statuses, '/tickets/' ~ ticket.id ~ '#subtasks') }}
                                        {% else %}
                                            {{ ui.status(sub.status_name, sub.status_colour) }}
                                        {% endif %}
                                    </span>
                                </li>
                            {% endfor %}
                        </ul>
                    {% else %}
                        <p class="card__body muted">{{ 'Break it into steps: each gets its own person, column and hours, and the ticket adds them up.'|t }}</p>
                    {% endif %}
                    {% if can_work and not finished %}
                        <form class="subtasks__add" method="post" action="{{ url('/tickets/' ~ ticket.id ~ '/subtasks') }}">
                            <input type="hidden" name="_token" value="{{ csrf_token }}">
                            <input class="field field--inline subtasks__input" type="text" name="title" required maxlength="250"
                                   placeholder="{{ 'The next step'|t }}" aria-label="{{ 'Title of the subtask'|t }}">
                            <select class="field field--inline" name="assignee_id" aria-label="{{ 'Assignee'|t }}">
                                <option value="">{{ 'Nobody yet'|t }}</option>
                                {% for person in people %}
                                    <option value="{{ person.id }}"{{ person.id == current_user.id ? ' selected' : '' }}>{{ person.name }}</option>
                                {% endfor %}
                            </select>
                            <button class="button button--small" type="submit">{{ 'Add a subtask'|t }}</button>
                        </form>
                    {% endif %}
                </section>
            {% endif %}

            {% include 'common/attachments.twig' with {upload_url: url('/tickets/' ~ ticket.id ~ '/attachments')} %}

            {#
                How this ticket depends on others. Each link reads from this
                ticket's end — "blocks CT-7", "is blocked by CT-3" — whichever
                end it was made from.
            #}
            {% set link_phrases = {
                'blocks-out': 'blocks', 'blocks-in': 'is blocked by',
                'relates-out': 'relates to', 'relates-in': 'relates to',
                'duplicates-out': 'duplicates', 'duplicates-in': 'is duplicated by'
            } %}
            <section class="card" id="links">
                <h2 class="card__title">{{ 'Links'|t }}</h2>
                {% if links is not empty %}
                    <ul class="links">
                        {% for link in links %}
                            <li class="links__item">
                                <span class="links__kind">{{ link_phrases[link.kind ~ '-' ~ link.direction]|t }}</span>
                                <a class="ticket-key" href="{{ url('/tickets/' ~ link.other_id) }}">{{ link.other_code }}-{{ link.other_number }}</a>
                                <a class="links__title{{ link.other_category == 'done' ? ' links__title--done' : '' }}" href="{{ url('/tickets/' ~ link.other_id) }}">{{ link.other_title }}</a>
                                {{ ui.status(link.other_status, link.other_colour) }}
                                <form method="post" action="{{ url('/links/' ~ link.id ~ '/delete') }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token }}">
                                    <input type="hidden" name="from" value="{{ ticket.id }}">
                                    <button class="link-button" type="submit" aria-label="{{ 'Remove this link'|t }}" title="{{ 'Remove this link'|t }}">×</button>
                                </form>
                            </li>
                        {% endfor %}
                    </ul>
                {% endif %}
                {% if can_work %}
                <form class="link-form" method="post" action="{{ url('/tickets/' ~ ticket.id ~ '/links') }}">
                    <input type="hidden" name="_token" value="{{ csrf_token }}">
                    <span>{{ 'This ticket'|t }}</span>
                    <select class="field field--inline" name="kind" aria-label="{{ 'How'|t }}">
                        {% for kind, phrase in {blocks: 'blocks', blocked_by: 'is blocked by', relates: 'relates to', duplicates: 'duplicates', duplicated_by: 'is duplicated by'} %}
                            <option value="{{ kind }}">{{ phrase|t }}</option>
                        {% endfor %}
                    </select>
                    <input class="field field--inline link-form__key" type="text" name="key" required
                           placeholder="CT-14" aria-label="{{ 'Ticket'|t }}" pattern="[A-Za-z][A-Za-z0-9]{1,9}-[0-9]+">
                    <button class="button button--small" type="submit">{{ 'Link'|t }}</button>
                </form>
                {% endif %}
            </section>

            {#
                What was said and what happened, in one stream — see
                TicketController::timeline for why they are read together.
            #}
            <section class="card" id="activity" data-refresh="activity">
                <header class="activity__head">
                    <h2 class="card__title">{{ 'Activity'|t }}</h2>
                    <nav class="segmented" aria-label="{{ 'Show'|t }}">
                        {% for value, label in {all: 'Everything', comments: 'Comments', history: 'History'} %}
                            <a class="segmented__item{{ showing == value ? ' is-active' : '' }}"
                               href="{{ url('/tickets/' ~ ticket.id ~ (value == 'all' ? '' : '?activity=' ~ value)) }}#activity"
                               {{ showing == value ? 'aria-current="true"' : '' }}>{{ label|t }}</a>
                        {% endfor %}
                    </nav>
                </header>

                {% if timeline is empty %}
                    <p class="card__body muted">{{ showing == 'history' ? 'Nothing has happened to it yet.'|t : 'Nobody has said anything yet.'|t }}</p>
                {% else %}
                    <ol class="timeline">
                        {% for item in timeline %}
                            {% if item.kind == 'comment' %}
                                {% set comment = item.comment %}
                                <li class="timeline__comment" id="comment-{{ comment.id }}">
                                    {{ ui.face(comment.user_name, comment.user_id, 'avatar avatar--small') }}
                                    <div class="comment">
                                        <header class="comment__head">
                                            <strong>{{ comment.user_name }}</strong>
                                            <time class="muted" datetime="{{ comment.created_at }}">{{ comment.created_at|day }} {{ comment.created_at|date('H:i') }}</time>
                                            {% if comment.edited_at %}<span class="muted" title="{{ comment.edited_at }}">· {{ 'edited'|t }}</span>{% endif %}
                                        </header>
                                        <div class="comment__body markdown">{{ comment.body|markdown }}</div>

                                        {% if comment.user_id == current_user.id or is_admin %}
                                            <div class="comment__actions">
                                                {% if comment.user_id == current_user.id %}
                                                    <details class="comment__edit">
                                                        <summary class="link-button link-button--text">{{ 'Edit'|t }}</summary>
                                                        <form method="post" action="{{ url('/comments/' ~ comment.id) }}">
                                                            <input type="hidden" name="_token" value="{{ csrf_token }}">
                                                            <textarea class="field" name="body" rows="4" required data-suggest>{{ comment.body }}</textarea>
                                                            <button class="button button--small button--primary" type="submit">{{ 'Save'|t }}</button>
                                                        </form>
                                                    </details>
                                                {% endif %}
                                                <form method="post" action="{{ url('/comments/' ~ comment.id ~ '/delete') }}"
                                                      data-confirm="{{ 'Delete this comment?'|t }}">
                                                    <input type="hidden" name="_token" value="{{ csrf_token }}">
                                                    <button class="link-button link-button--text" type="submit">{{ 'Delete'|t }}</button>
                                                </form>
                                            </div>
                                        {% endif %}
                                    </div>
                                </li>
                            {% else %}
                                <li class="timeline__event">
                                    <span class="timeline__dot" aria-hidden="true"></span>
                                    <span>{{ ui.event_line(item.event) }}</span>
                                    <time class="muted" datetime="{{ item.event.created_at }}">{{ item.event.created_at|day }} {{ item.event.created_at|date('H:i') }}</time>
                                </li>
                            {% endif %}
                        {% endfor %}
                    </ol>
                {% endif %}

                {% if showing != 'history' %}
                    <form class="comment-form" id="comment-form" method="post" action="{{ url('/tickets/' ~ ticket.id ~ '/comments') }}">
                        <input type="hidden" name="_token" value="{{ csrf_token }}">
                        <label for="body">{{ 'Add a comment'|t }}</label>
                        <textarea id="body" class="field" name="body" rows="4" required data-suggest data-paste-upload="{{ url('/tickets/' ~ ticket.id ~ '/attachments') }}"
                                  placeholder="{{ 'Markdown works. CT-14 links to that ticket, @name tells somebody.'|t }}"></textarea>
                        <button class="button button--primary" type="submit">{{ 'Comment'|t }}</button>
                    </form>
                {% endif %}
            </section>

            {% if can_work %}
            <section class="card">
                <h2 class="card__title">{{ 'Log time'|t }}</h2>
                {#
                    On the ticket rather than on a separate page: the moment
                    somebody is willing to write down where an hour went is the
                    moment they are looking at what they did it on.
                #}
                <form class="log-form" method="post" action="{{ url('/tickets/' ~ ticket.id ~ '/log') }}">
                    <input type="hidden" name="_token" value="{{ csrf_token }}">

                    <div>
                        <label for="time">{{ 'How long'|t }}</label>
                        <input id="time" class="field" type="text" name="time" placeholder="1h 30m" required>
                    </div>

                    <div>
                        <label for="work_date">{{ 'Which day'|t }}</label>
                        {# Defaults to today, which it is nine times in ten, and
                           accepts any past day because Friday's hours are
                           regularly written down on Monday. #}
                        <input id="work_date" class="field" type="date" name="work_date"
                               value="{{ today }}" max="{{ today }}">
                    </div>

                    <div>
                        <label for="started_at">{{ 'Started at'|t }}</label>
                        <input id="started_at" class="field" type="time" name="started_at" step="300">
                    </div>

                    {% include 'common/work_type_field.twig' with {id: 'work_type'} %}

                    <div class="log-form__note">
                        <label for="note">{{ 'What you did'|t }}</label>
                        <input id="note" class="field" type="text" name="note" maxlength="500"
                               placeholder="{{ 'Optional'|t }}">
                    </div>

                    <button class="button button--primary" type="submit">{{ 'Log it'|t }}</button>

                    {# What is left once this is logged. Empty: what was left,
                       less this — until somebody knows better. #}
                    <label class="check check--inline log-form__billable">
                        <input type="hidden" name="billable_sent" value="1">
                        <input type="checkbox" name="billable" value="1"{{ ticket.project_billable ? ' checked' : '' }}>
                        {{ 'Billable'|t }}
                    </label>

                    <div class="log-form__remaining">
                        <label for="remaining">{{ 'Left afterwards'|t }}</label>
                        <input id="remaining" class="field" type="text" name="remaining"
                               placeholder="{{ remaining is not null ? 'counted down: {left}'|t({left: remaining|duration}) : 'no estimate'|t }}">
                    </div>
                </form>

                {% set timer = running_timer() %}
                <div class="timer-control">
                    {% if timer and timer.ticket_id == ticket.id %}
                        <form method="post" action="{{ url('/timer/stop') }}" class="timer-control__form">
                            <input type="hidden" name="_token" value="{{ csrf_token }}">
                            <input type="hidden" name="back" value="/tickets/{{ ticket.id }}">
                            <span class="timer-control__running" data-timer-started="{{ timer.started_at|date('U') }}">
                                <span class="timer__dot" aria-hidden="true"></span>
                                {{ 'The clock is running on this ticket'|t }} · <span data-timer-clock></span>
                            </span>
                            <input class="field field--inline" type="text" name="note" maxlength="500" placeholder="{{ 'What you did'|t }}" aria-label="{{ 'What you did'|t }}">
                            <button class="button button--primary button--small" type="submit">{{ 'Stop and log'|t }}</button>
                        </form>
                        <form method="post" action="{{ url('/timer/discard') }}">
                            <input type="hidden" name="_token" value="{{ csrf_token }}">
                            <input type="hidden" name="back" value="/tickets/{{ ticket.id }}">
                            <button class="link-button link-button--text" type="submit">{{ 'Throw it away'|t }}</button>
                        </form>
                    {% else %}
                        <form method="post" action="{{ url('/tickets/' ~ ticket.id ~ '/timer') }}">
                            <input type="hidden" name="_token" value="{{ csrf_token }}">
                            <input type="hidden" name="back" value="/tickets/{{ ticket.id }}">
                            <button class="button button--small" type="submit">▶ {{ 'Start the clock'|t }}</button>
                            {% if timer %}<span class="hint">{{ 'The one on {key} is stopped and logged first.'|t({key: timer.project_code ~ '-' ~ timer.ticket_number}) }}</span>{% endif %}
                        </form>
                    {% endif %}
                </div>

                {% if worklogs is empty %}
                    <p class="card__body">{{ 'No hours logged against this ticket yet.'|t }}</p>
                {% else %}
                    <ul class="logs logs--ticket">
                        {% for entry in worklogs %}
                            {{ ui.log_entry(entry, '/tickets/' ~ ticket.id, 'ticket') }}
                        {% endfor %}
                    </ul>
                {% endif %}
            </section>
            {% endif %}
        </div>

        <aside class="split__side">
            <section class="card">
                {% include 'tickets/facts.twig' %}
            </section>

            {% if pages is not empty %}
                <section class="card">
                    <h2 class="card__title">{{ 'Written about on'|t }}</h2>
                    <ul class="page-results">
                        {% for mentioned in pages %}
                            <li><a href="{{ url('/pages/' ~ mentioned.id) }}">{{ mentioned.title }}</a> <span class="muted">{{ mentioned.project_code }}</span></li>
                        {% endfor %}
                    </ul>
                </section>
            {% endif %}

            {% if is_admin %}
                <section class="card">
                    <h2 class="card__title">{{ 'Delete'|t }}</h2>
                    {% if subtasks is not empty %}
                        <p class="card__body">{{ 'This ticket has subtasks. Delete them first, or make them tickets of their own.'|t }}</p>
                    {% elseif worklogs is empty %}
                        <form method="post" action="{{ url('/tickets/' ~ ticket.id ~ '/delete') }}"
                              data-confirm="{{ 'Delete {key}?'|t({key: key}) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token }}">
                            <button class="button button--danger" type="submit">{{ 'Delete ticket'|t }}</button>
                        </form>
                    {% else %}
                        {# Hours are not deleted along with a ticket: they are what
                           gets reported and invoiced. #}
                        <p class="card__body">{{ 'This ticket has hours logged against it, so it cannot be deleted. Move it to done instead.'|t }}</p>
                    {% endif %}
                </section>
            {% endif %}
        </aside>
    </div>
{% endblock %}
