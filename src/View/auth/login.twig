{% extends 'auth/frame.twig' %}

{% block title %}{{ 'Sign in'|t }}{% endblock %}

{% block card %}
    <h1>{{ app_name }}</h1>
    <p class="auth__lead">{{ 'Issue tracking, and the hours that went into it.'|t }}</p>

    {% if error %}
        <p class="flash flash--danger" role="alert">{{ error }}</p>
    {% endif %}

    <form method="post" action="{{ url('/login') }}" novalidate
          {% if recaptcha_key|default(null) %}data-recaptcha="login" data-recaptcha-key="{{ recaptcha_key }}"{% endif %}>
        <input type="hidden" name="_token" value="{{ csrf_token }}">
        <input type="hidden" name="recaptcha_token" value="">

        <label for="email">{{ 'Email address'|t }}</label>
        <input id="email" class="field" type="email" name="email" value="{{ email }}"
               autocomplete="username" autofocus required>

        <label for="password">{{ 'Password'|t }}</label>
        <input id="password" class="field" type="password" name="password"
               autocomplete="current-password" required>

        <button class="button button--primary button--block" type="submit">{{ 'Sign in'|t }}</button>
    </form>

    <p class="auth__back"><a href="{{ url('/password/forgot') }}">{{ 'Forgot your password?'|t }}</a></p>

    {# The language, before there is a profile to keep it on. #}
    <div class="auth__langs" role="group" aria-label="{{ 'Language'|t }}">
        {% for code, name in locales %}
            <form method="post" action="{{ url('/locale') }}">
                <input type="hidden" name="_token" value="{{ csrf_token }}">
                <button class="link-button{{ code == locale ? ' is-current' : '' }}" type="submit" name="locale" value="{{ code }}" lang="{{ code }}"
                        {{ code == locale ? 'aria-current="true"' : '' }}>{{ name }}</button>
            </form>
        {% endfor %}
    </div>
    {% if recaptcha_key|default(null) %}
        <p class="auth__note">{{ 'This page is protected by reCAPTCHA; Google’s privacy policy and terms apply.'|t }}</p>
    {% endif %}
{% endblock %}
