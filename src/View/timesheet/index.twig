{% extends 'layout.twig' %}
{% import 'common/macros.twig' as ui %}

{% set week_query = 'week=' ~ monday ~ '&user=' ~ person.id %}

{% block title %}{{ 'Timesheet'|t }} — {{ app_name }}{% endblock %}
{% block heading %}{{ is_mine ? 'Your week'|t : '{name}’s week'|t({name: person.name}) }}{% endblock %}
{% block subheading %}
    <p class="content__sub">{{ monday|day }} — {{ sunday|day }}</p>
{% endblock %}

{% block actions %}
    <nav class="segmented" aria-label="{{ 'Show the week as'|t }}">
        <a class="segmented__item{{ view == 'days' ? ' is-active' : '' }}" href="{{ url('/timesheet?' ~ week_query) }}">{{ 'Days'|t }}</a>
        <a class="segmented__item{{ view == 'grid' ? ' is-active' : '' }}" href="{{ url('/timesheet?view=grid&' ~ week_query) }}">{{ 'Grid'|t }}</a>
        <a class="segmented__item{{ view == 'calendar' ? ' is-active' : '' }}" href="{{ url('/timesheet?view=calendar&' ~ week_query) }}">{{ 'Calendar'|t }}</a>
    </nav>
    <a class="button" href="{{ url('/timesheet/team?week=' ~ monday) }}">{{ 'The team'|t }}</a>
    <a class="button" href="{{ url('/timesheet?view=' ~ view ~ '&week=' ~ previous_week ~ '&user=' ~ person.id) }}">← {{ 'Previous'|t }}</a>
    <a class="button" href="{{ url('/timesheet?view=' ~ view ~ '&user=' ~ person.id) }}">{{ 'This week'|t }}</a>
    {% if has_next %}
        <a class="button" href="{{ url('/timesheet?view=' ~ view ~ '&week=' ~ next_week ~ '&user=' ~ person.id) }}">{{ 'Next'|t }} →</a>
    {% endif %}
{% endblock %}

{% block content %}
    {# Whose week. A form rather than a list of links, because it is one control
       and the list of people grows. #}
    <form class="filters card" method="get" action="{{ url('/timesheet') }}">
        <input type="hidden" name="week" value="{{ monday }}">
        <input type="hidden" name="view" value="{{ view }}">
        <label class="check--inline" for="user">{{ 'Whose week'|t }}</label>
        <select id="user" class="field field--inline" name="user" data-autosubmit>
            {% for one in people %}
                <option value="{{ one.id }}"{{ person.id == one.id ? ' selected' : '' }}>{{ one.name }}</option>
            {% endfor %}
        </select>
        <button class="button autosubmit__button" type="submit">{{ 'Show'|t }}</button>
    </form>

    {# Where the week stands: open, handed in, approved, or sent back — and
       whether its days are closed by the lock date. #}
    {% if week_state %}
        {% if week_state.state == 'approved' %}
            <p class="flash flash--success">{{ 'This week is approved; its hours no longer change.'|t }}</p>
        {% elseif week_state.state == 'submitted' %}
            <p class="flash">{{ 'This week was handed in on {day}, and waits for approval. Its hours stay as they are until then.'|t({day: week_state.submitted_at|day}) }}</p>
        {% else %}
            <p class="flash flash--warning">{{ 'This week was sent back: {reason}'|t({reason: week_state.comment}) }}</p>
        {% endif %}
    {% endif %}
    {% if locked_until and monday <= locked_until %}
        <p class="flash flash--warning">{{ 'Hours up to {day} are closed.'|t({day: locked_until|day}) }}</p>
    {% endif %}

    <div class="stats">
        <div class="stat">
            <div class="stat__label">{{ 'Logged this week'|t }}</div>
            <div class="stat__value">{{ total|duration }}</div>
        </div>
        <div class="stat">
            <div class="stat__label">{{ 'Of a {hours}-hour week'|t({hours: (expected_week / 60)|round}) }}</div>
            <div class="stat__value">{{ expected_week > 0 ? (total / expected_week * 100)|round : 0 }}%</div>
        </div>
        <div class="stat">
            <div class="stat__label">{{ 'Days with something on them'|t }}</div>
            <div class="stat__value">{{ days|filter(d => d.minutes > 0)|length }}</div>
        </div>
    </div>

    {% if view == 'grid' %}
        {#
            The week as a grid: a ticket per row, a day per column, each cell
            the time on that ticket that day, typed straight in. Saved as a
            whole; only the cells that changed change anything.
        #}
        <form method="post" action="{{ url('/timesheet/grid') }}" class="card card--flush grid-sheet">
            <input type="hidden" name="_token" value="{{ csrf_token }}">
            <input type="hidden" name="week" value="{{ monday }}">
            <input type="hidden" name="user" value="{{ person.id }}">
            <div class="grid-sheet__scroll">
                <table class="table grid-sheet__table">
                    <thead>
                    <tr>
                        <th>{{ 'Ticket'|t }}</th>
                        {% for date, day in days %}
                            <th class="grid-sheet__day{{ date|date('N') > 5 ? ' grid-sheet__day--weekend' : '' }}{{ date == today ? ' grid-sheet__day--today' : '' }}">
                                {{ date|date('D')|t }}<br><span class="muted">{{ date|date('j') }}</span>
                            </th>
                        {% endfor %}
                        <th class="table__number">{{ 'Total'|t }}</th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for row in grid %}
                        <tr>
                            <td class="grid-sheet__ticket">
                                <a class="ticket-key" href="{{ url('/tickets/' ~ row.ticket.id) }}">{{ row.ticket.project_code }}-{{ row.ticket.number }}</a>
                                <span class="grid-sheet__title" title="{{ row.ticket.title }}">{{ row.ticket.title }}</span>
                            </td>
                            {% for date, cell in row.cells %}
                                <td class="grid-sheet__cell{{ date|date('N') > 5 ? ' grid-sheet__cell--weekend' : '' }}">
                                    {% if cell.count > 1 %}
                                        {# Several entries in one cell are not rewritten from one
                                           number; they are changed on the day list. #}
                                        <span class="grid-sheet__several" title="{{ plural('{count} entry', '{count} entries', cell.count) }}">{{ cell.minutes|duration }}</span>
                                    {% elseif can_change and date <= today %}
                                        <input class="field grid-sheet__input" type="text" inputmode="text"
                                               name="cells[{{ row.ticket.id }}][{{ date }}]"
                                               value="{{ cell.minutes > 0 ? cell.minutes|duration : '' }}"
                                               aria-label="{{ '{key} on {day}'|t({key: row.ticket.project_code ~ '-' ~ row.ticket.number, day: date|day}) }}">
                                    {% else %}
                                        <span class="muted">{{ cell.minutes > 0 ? cell.minutes|duration : '' }}</span>
                                    {% endif %}
                                </td>
                            {% endfor %}
                            <td class="table__number"><strong>{{ row.total > 0 ? row.total|duration : '—' }}</strong></td>
                        </tr>
                    {% else %}
                        <tr><td colspan="9" class="card__empty">{{ 'Nothing logged this week, and nothing in progress. Add a ticket by its name below.'|t }}</td></tr>
                    {% endfor %}
                    </tbody>
                    <tfoot>
                    <tr>
                        <th>{{ 'Day'|t }}</th>
                        {% for date, day in days %}
                            <th class="grid-sheet__day{{ day.expected > 0 and day.minutes >= day.expected ? ' grid-sheet__day--full' : '' }}">
                                {{ day.minutes > 0 ? day.minutes|duration : '—' }}
                            </th>
                        {% endfor %}
                        <th class="table__number">{{ total|duration }}</th>
                    </tr>
                    </tfoot>
                </table>
            </div>

            {% if can_change %}
                <div class="grid-sheet__actions">
                    <button class="button button--primary" type="submit">{{ 'Save the week'|t }}</button>
                    <span class="hint">{{ 'Type 1h 30m, 90m or 1:30 into a day. An empty cell takes the entry out.'|t }}</span>
                </div>
            {% endif %}
        </form>

        {% if can_change %}
            <form class="filters card" method="get" action="{{ url('/timesheet') }}">
                <input type="hidden" name="view" value="grid">
                <input type="hidden" name="week" value="{{ monday }}">
                <input type="hidden" name="user" value="{{ person.id }}">
                <label class="check--inline" for="add">{{ 'Add a row for'|t }}</label>
                <input id="add" class="field field--inline" type="text" name="add" placeholder="CT-14" required>
                <button class="button" type="submit">{{ 'Add'|t }}</button>
            </form>
        {% endif %}
    {% elseif view == 'calendar' %}
        {#
            The week as a calendar: the hours down the side, a column a day,
            each entry with a start drawn as a block on its hours. Entries
            without a start are listed above the hours of their day.

            On one's own week, dragging over a day's empty hours opens "Log
            time" with that day, that start and that length filled in; a click
            is an hour from where it was clicked.
        #}
        {% set from = calendar.from %}
        {% set to = calendar.to %}
        <section class="card card--flush">
            <div class="calendar" style="--hours: {{ (to - from) / 60 }}"
                 {% if is_mine and can_work %}data-calendar data-from="{{ from }}"{% endif %}>
                <div class="calendar__corner"></div>
                {% for date, day in days %}
                    <div class="calendar__head{{ day.expected == 0 ? ' calendar__head--off' : '' }}{{ date == today ? ' calendar__head--today' : '' }}">
                        <strong>{{ date|date('D')|t }}</strong> <span>{{ date|date('j') }}</span>
                        <span class="calendar__total">{{ day.minutes > 0 ? day.minutes|duration : '' }}</span>
                        {% if day.holiday %}<span class="calendar__why">{{ day.holiday }}</span>{% endif %}
                        {% if day.absence %}<span class="calendar__why">{{ {vacation: 'Day off', sick: 'Ill', other: 'Away'}[day.absence]|t }}</span>{% endif %}
                    </div>
                {% endfor %}

                <div class="calendar__corner calendar__corner--loose"><span>{{ 'No start'|t }}</span></div>
                {% for date, day in calendar.days %}
                    <div class="calendar__loose">
                        {% for entry in day.loose %}
                            <a class="calendar__chip" href="{{ url('/tickets/' ~ entry.ticket_id) }}" title="{{ entry.ticket_title }}{{ entry.note ? ' — ' ~ entry.note : '' }}">
                                <strong>{{ entry.project_code }}-{{ entry.ticket_number }}</strong> {{ entry.minutes|duration }}
                            </a>
                        {% endfor %}
                    </div>
                {% endfor %}

                <div class="calendar__hours" aria-hidden="true">
                    {% for minute in range(from, to - 60, 60) %}
                        <span>{{ '%02d:00'|format(minute // 60) }}</span>
                    {% endfor %}
                </div>
                {% for date, day in calendar.days %}
                    {% set info = days[date] %}
                    <div class="calendar__day{{ info.expected == 0 ? ' calendar__day--off' : '' }}{{ date > today ? ' calendar__day--future' : '' }}"
                         data-date="{{ date }}"{{ date > today ? ' data-future' : '' }}>
                        {% for block in day.placed %}
                            {% set entry = block.entry %}
                            <a class="calendar__block{{ entry.billable is defined and not entry.billable and entry.project_billable|default(1) ? ' calendar__block--unbilled' : '' }}"
                               href="{{ url('/tickets/' ~ entry.ticket_id) }}"
                               style="top: calc({{ block.start - from }} * var(--ppm)); height: calc({{ block.end - block.start }} * var(--ppm)); left: calc({{ block.lane }} * 100% / {{ block.lanes }}); width: calc(100% / {{ block.lanes }} - 4px);"
                               title="{{ entry.project_code }}-{{ entry.ticket_number }} {{ entry.ticket_title }}{{ entry.note ? ' — ' ~ entry.note : '' }}">
                                <span class="calendar__when">{{ '%02d:%02d'|format(block.start // 60, block.start % 60) }}–{{ '%02d:%02d'|format(block.end // 60, block.end % 60) }} · {{ entry.minutes|duration }}</span>
                                <strong>{{ entry.project_code }}-{{ entry.ticket_number }}</strong>
                                <span class="calendar__title">{{ entry.ticket_title }}</span>
                                {% if entry.work_type_name|default(null) %}<span class="calendar__type">{{ entry.work_type_name }}</span>{% endif %}
                            </a>
                        {% endfor %}
                    </div>
                {% endfor %}
            </div>
        </section>
        {% if is_mine and can_work %}
            <p class="hint">{{ 'Drag over a day’s hours to log that stretch; a click logs an hour from there. Entries get their place from their start, which the ticket’s form, “Log time” and the clock all fill in.'|t }}</p>
        {% endif %}
    {% else %}
        <div class="split">
            <div class="split__main">
                {% for date, day in days %}
                    {% set weekend = day.expected == 0 %}
                    <section class="day{{ weekend ? ' day--weekend' : '' }}{{ day.minutes == 0 ? ' day--empty' : '' }}">
                        <header class="day__head">
                            <div>
                                <strong>{{ date|date('l')|t }}</strong>
                                <span class="muted">{{ date|day }}</span>
                                {% if day.holiday %}<span class="badge badge--violet">{{ day.holiday }}</span>{% endif %}
                                {% if day.absence %}<span class="badge badge--amber">{{ {vacation: 'Day off', sick: 'Ill', other: 'Away'}[day.absence]|t }}</span>{% endif %}
                            </div>
                            <div class="day__total">
                                {{ day.minutes > 0 ? day.minutes|duration : '—' }}
                                {#
                                    The bar is against a full day, and it is capped at
                                    100% so a ten-hour day does not draw past its box —
                                    the number beside it is what says it was ten.
                                #}
                                {% if day.minutes > 0 and not weekend %}
                                    <span class="bar bar--day">
                                        <span class="bar__fill{{ day.minutes >= day.expected ? ' bar__fill--full' : '' }}"
                                              style="width: {{ min(100, (day.minutes / day.expected * 100)|round) }}%"></span>
                                    </span>
                                {% endif %}
                            </div>
                        </header>

                        {% if day.entries is empty %}
                            <p class="day__empty">{{ day.holiday or day.absence ? 'Nothing expected'|t : (weekend ? 'Weekend'|t : 'Nothing logged'|t) }}</p>
                        {% else %}
                            <ul class="logs">
                                {% for entry in day.entries %}
                                    {{ ui.log_entry(entry, '/timesheet?' ~ week_query, 'timesheet') }}
                                {% endfor %}
                            </ul>
                        {% endif %}
                    </section>
                {% endfor %}
            </div>

            <aside class="split__side">
                {% if can_submit and (not week_state or week_state.state == 'rejected') %}
                    <section class="card">
                        <h2 class="card__title">{{ 'Hand the week in'|t }}</h2>
                        <p class="card__body">{{ 'When the week is complete. Its hours then stay as they are until an administrator approves it or sends it back.'|t }}</p>
                        <form method="post" action="{{ url('/timesheet/submit') }}"
                              data-confirm="{{ 'Hand in the week of {day}?'|t({day: monday|day}) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token }}">
                            <input type="hidden" name="week" value="{{ monday }}">
                            <button class="button button--primary" type="submit">{{ 'Hand it in'|t }}</button>
                        </form>
                    </section>
                {% endif %}

                <section class="card">
                    <h2 class="card__title">{{ 'Days away'|t }}</h2>
                    {% if absences is not empty %}
                        <ul class="split-list">
                            {% for away in absences %}
                                <li>
                                    <span>{{ {vacation: 'Day off', sick: 'Ill', other: 'Away'}[away.kind]|t }}</span>
                                    <span class="muted">{{ away.starts_on|day }}{% if away.ends_on != away.starts_on %} — {{ away.ends_on|day }}{% endif %}{% if away.note %} · {{ away.note }}{% endif %}</span>
                                    {% if can_change %}
                                        <form method="post" action="{{ url('/absences/' ~ away.id ~ '/delete') }}">
                                            <input type="hidden" name="_token" value="{{ csrf_token }}">
                                            <input type="hidden" name="back" value="/timesheet?{{ week_query }}">
                                            <button class="link-button" type="submit" aria-label="{{ 'Remove'|t }}">×</button>
                                        </form>
                                    {% endif %}
                                </li>
                            {% endfor %}
                        </ul>
                    {% endif %}
                    {% if can_change %}
                        <details class="absence-form">
                            <summary class="link-button link-button--text">{{ 'Add days away'|t }}</summary>
                            <form method="post" action="{{ url('/absences') }}">
                                <input type="hidden" name="_token" value="{{ csrf_token }}">
                                <input type="hidden" name="user" value="{{ person.id }}">
                                <input type="hidden" name="back" value="/timesheet?{{ week_query }}">
                                <div class="form__row">
                                    <div>
                                        <label for="starts_on">{{ 'From'|t }}</label>
                                        <input id="starts_on" class="field" type="date" name="starts_on" value="{{ today }}" required>
                                    </div>
                                    <div>
                                        <label for="ends_on">{{ 'Until'|t }}</label>
                                        <input id="ends_on" class="field" type="date" name="ends_on" value="{{ today }}">
                                    </div>
                                </div>
                                <select class="field" name="kind" aria-label="{{ 'Why'|t }}">
                                    <option value="vacation">{{ 'Day off'|t }}</option>
                                    <option value="sick">{{ 'Ill'|t }}</option>
                                    <option value="other">{{ 'Away'|t }}</option>
                                </select>
                                <input class="field" type="text" name="note" maxlength="200" placeholder="{{ 'Optional'|t }}" aria-label="{{ 'Note'|t }}">
                                <button class="button button--small" type="submit">{{ 'Add'|t }}</button>
                            </form>
                        </details>
                    {% endif %}
                </section>

                <section class="card">
                    <h2 class="card__title">{{ 'Where it went'|t }}</h2>
                    {% if by_project is empty %}
                        <p class="card__body">{{ 'Nothing logged this week.'|t }}</p>
                    {% else %}
                        <ul class="split-list">
                            {% for row in by_project %}
                                <li>
                                    <a href="{{ url('/projects/' ~ row.id) }}">{{ row.code }}</a>
                                    <span class="muted">{{ row.name }}</span>
                                    <strong>{{ row.minutes|duration }}</strong>
                                    <span class="bar">
                                        <span class="bar__fill" style="width: {{ total > 0 ? (row.minutes / total * 100)|round : 0 }}%"></span>
                                    </span>
                                </li>
                            {% endfor %}
                        </ul>
                    {% endif %}
                </section>

                {% if is_admin and team is not empty %}
                    <section class="card">
                        <h2 class="card__title">{{ 'The team this week'|t }}</h2>
                        <ul class="split-list">
                            {% for one in people %}
                                {% set minutes = team[one.id] is defined ? team[one.id]|reduce((sum, m) => sum + m, 0) : 0 %}
                                <li>
                                    <a href="{{ url('/timesheet?week=' ~ monday ~ '&user=' ~ one.id) }}">{{ one.name }}</a>
                                    <strong>{{ minutes > 0 ? minutes|duration : '—' }}</strong>
                                    <span class="bar">
                                        <span class="bar__fill" style="width: {{ min(100, expected_week > 0 ? (minutes / expected_week * 100)|round : 0) }}%"></span>
                                    </span>
                                </li>
                            {% endfor %}
                        </ul>
                    </section>
                {% endif %}
            </aside>
        </div>
    {% endif %}
{% endblock %}
